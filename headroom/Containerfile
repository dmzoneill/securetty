FROM localhost/securetty_base:latest

ARG QUARANTINE_DAYS=7
RUN CUTOFF_ISO=$(date -u -d "${QUARANTINE_DAYS} days ago" +%Y-%m-%dT%H:%M:%SZ) \
    && echo "Installing headroom-ai + deps (>= ${QUARANTINE_DAYS}d old)" \
    && python3.12 -m pip install --break-system-packages \
        "headroom-ai[proxy]" \
    && ln -sf /usr/local/lib/python3.12/site-packages/bin/headroom /usr/local/bin/headroom

# Verify fastapi is installed
RUN python3.12 -c "import fastapi; print(f'fastapi {fastapi.__version__}')"

RUN groupadd -g 1000 headroom \
    && useradd -u 1000 -g 1000 -m -s /bin/bash headroom \
    && mkdir -p /data && chown headroom:headroom /data

COPY entrypoint.sh /usr/local/bin/headroom-entrypoint.sh
RUN chmod +x /usr/local/bin/headroom-entrypoint.sh

USER headroom
WORKDIR /data

EXPOSE 8787 8788

CMD ["/usr/local/bin/headroom-entrypoint.sh"]
