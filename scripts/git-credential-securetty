#!/bin/bash
# git-credential-securetty — fetches credentials from securetty-creds proxy
[ "$1" = "get" ] || exit 0

declare -A c
while IFS='=' read -r k v; do
    [ -z "$k" ] && break
    c[$k]="$v"
done

host="${c[host]:-}"
protocol="${c[protocol]:-https}"

[ -z "$host" ] && exit 1

curl -sf "http://securetty-creds:8800/credential?host=${host}&protocol=${protocol}" 2>/dev/null || exit 1
