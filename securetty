#!/bin/bash
# securetty — sandboxed development container with delayed ingestion.
#
# Usage:
#   ./securetty build     - Build the container image
#   ./securetty rebuild   - Force rebuild (no cache, fresh delayed versions)
#   ./securetty up        - Start the container (detached)
#   ./securetty shell     - Open a shell inside the container
#   ./securetty install   - Run dependency install inside container
#   ./securetty lockdown  - Disconnect network (air-gap after install)
#   ./securetty unlock    - Reconnect network
#   ./securetty age       - Show image age and agent versions
#   ./securetty down      - Stop and remove the container
#   ./securetty nuke      - Remove container + volumes (full reset)
#   ./securetty status    - Show container and network state
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
cd "$SCRIPT_DIR"

cmd="${1:-help}"

case "$cmd" in
    build)
        podman-compose build
        ;;
    rebuild)
        echo "Rebuilding with no cache (fresh delayed versions)..."
        podman-compose build --no-cache
        echo ""
        echo "Rebuild complete. Restart container:"
        echo "  ./securetty down && ./securetty up"
        ;;
    up)
        # Generate fresh .env from host environment
        bash scripts/generate-env.sh "$SCRIPT_DIR/.env"
        # Start restricted SSH agent (only dmzoneill-2024)
        bash scripts/ssh-agent-restricted.sh start
        # Start URL relay (xdg-open from container opens on host)
        bash scripts/open-relay-host.sh start &
        disown
        sleep 0.3
        podman-compose up -d
        # Setup omniroute providers + pull ollama models in background
        (
            sleep 5  # wait for services to start
            bash "$SCRIPT_DIR/scripts/setup-omniroute.sh" 2>/dev/null
            for model in qwen3:8b qwen3:32b deepseek-coder-v2:16b; do
                if ! podman exec securetty-ollama ollama list 2>/dev/null | grep -q "${model%%:*}"; then
                    echo "Pulling ollama model: $model"
                    podman exec securetty-ollama ollama pull "$model" &
                fi
            done
        ) &
        disown
        echo "Container started. Run: ./securetty shell"
        echo "Ollama models pulling in background (qwen3:8b, qwen3:32b, deepseek-coder-v2:16b)"
        ;;
    shell)
        podman exec -it securetty /usr/local/bin/entrypoint.sh /bin/bash
        ;;
    install)
        podman exec -it securetty /bin/bash /workspace/.securetty/install.sh
        ;;
    lockdown)
        bash scripts/lockdown-network.sh
        ;;
    unlock)
        bash scripts/reconnect-network.sh
        ;;
    age)
        if ! podman image exists securetty_dev 2>/dev/null && ! podman image exists securetty-dev 2>/dev/null; then
            # Try reading from running container
            if podman container exists securetty 2>/dev/null; then
                podman exec securetty cat /etc/securetty-manifest.json 2>/dev/null | jq '
                    .build_date as $bd |
                    (now - ($bd | sub("\\.[0-9]+Z$"; "Z") | fromdateiso8601)) / 86400 | floor as $age |
                    {
                        image_age_days: $age,
                        build_date: $bd,
                        quarantine_days: .quarantine_days,
                        agent_count: (.agents | length),
                        stale: ($age >= 14),
                        agents: [.agents[] | {name, version, published}]
                    }
                '
            else
                echo "No container or image found. Run: ./securetty build"
            fi
        else
            # Read from image
            local_image=$(podman images --filter reference='*securetty*dev*' --format '{{.Repository}}:{{.Tag}}' | head -1)
            if [ -n "$local_image" ]; then
                podman run --rm --entrypoint cat "$local_image" /etc/securetty-manifest.json 2>/dev/null | jq '
                    .build_date as $bd |
                    (now - ($bd | sub("\\.[0-9]+Z$"; "Z") | fromdateiso8601)) / 86400 | floor as $age |
                    {
                        image_age_days: $age,
                        build_date: $bd,
                        quarantine_days: .quarantine_days,
                        agent_count: (.agents | length),
                        stale: ($age >= 14),
                        agents: [.agents[] | {name, version, published}]
                    }
                '
            else
                echo "No image found. Run: ./securetty build"
            fi
        fi
        ;;
    down)
        podman-compose down
        bash scripts/open-relay-host.sh stop 2>/dev/null || true
        bash scripts/ssh-agent-restricted.sh stop 2>/dev/null || true
        ;;
    nuke)
        podman-compose down -v
        bash scripts/open-relay-host.sh stop 2>/dev/null || true
        bash scripts/ssh-agent-restricted.sh stop 2>/dev/null || true
        echo "Container and volumes removed."
        ;;
    status)
        echo "=== Container ==="
        podman ps -a --filter name=securetty --format "table {{.Names}}\t{{.Status}}\t{{.Ports}}"
        echo ""
        echo "=== Network ==="
        NETWORK=$(podman inspect securetty --format '{{range $k, $v := .NetworkSettings.Networks}}{{$k}}{{end}}' 2>/dev/null || echo "none")
        if [ "$NETWORK" = "" ] || [ "$NETWORK" = "none" ]; then
            echo "Network: DISCONNECTED (air-gapped)"
        else
            echo "Network: $NETWORK (connected)"
        fi
        echo ""
        echo "=== Volumes ==="
        podman volume ls --filter name=securetty
        echo ""
        echo "=== Image Age ==="
        "$0" age 2>/dev/null || echo "No image built yet."
        ;;
    help|*)
        echo "securetty — sandboxed development container"
        echo ""
        echo "Commands:"
        echo "  build     Build container image (delayed agent versions)"
        echo "  rebuild   Force rebuild with no cache (fresh delayed versions)"
        echo "  up        Start container"
        echo "  shell     Open shell inside container"
        echo "  install   Run dependency install (needs network)"
        echo "  lockdown  Disconnect network (air-gap)"
        echo "  unlock    Reconnect network"
        echo "  age       Show image age and agent versions"
        echo "  down      Stop container"
        echo "  nuke      Remove container + all volumes"
        echo "  status    Show container/network/volume/age state"
        ;;
esac
