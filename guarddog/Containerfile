FROM localhost/securetty_base:latest

RUN python3.12 -m pip install --target /usr/local/lib/python3.12/site-packages guarddog

RUN groupadd -g 1000 scanner \
    && useradd -u 1000 -g 1000 -m -s /bin/bash scanner \
    && mkdir -p /results && chown scanner:scanner /results

COPY scripts/guarddog-watch.sh /usr/local/bin/guarddog-watch.sh
RUN chmod +x /usr/local/bin/guarddog-watch.sh

USER scanner
WORKDIR /results

CMD ["/usr/local/bin/guarddog-watch.sh"]
