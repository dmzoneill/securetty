FROM localhost/securetty_base:latest

# =============================================================================
# securetty devbase — system packages + dev tools (cached intermediate layer)
# Rarely changes. Rebuild only when adding/removing system packages.
# =============================================================================

# Development Tools group + all system packages
RUN dnf group install -y development-tools \
    && dnf install -y --setopt=install_weak_deps=False \
        gsettings-desktop-schemas util-linux glib2 iproute pciutils pipewire-pulseaudio gjs which dnf-plugins-core dbus-tools xdg-utils ansible-core git-core dbus-daemon mesa-dri-drivers python3-devel ImageMagick iputils gcc g++ python3-pytest net-tools sassc python3-flake8 openssh-clients xz gettext rpm-build tree yamllint python3 awscli2 bind-utils findutils unzip glab socat tar dconf golang ruff gnome-extensions-app gnupg2 sound-theme-freedesktop mutter-devkit gnome-shell ffmpeg skopeo mesa-libEGL man-db python3-lxml lsof make gh hostname nmap-ncat git libxml2 pulseaudio-utils python3-ansible-lint ncat sshpass sqlite nmap podman-remote python3-pip glib2-devel \
    && dnf clean all \
    && rm -rf /var/cache/dnf

# Verify Node >= 22 (required by Codex CLI, Cline)
RUN node_ver=$(node -v | sed 's/v//' | cut -d. -f1) \
    && if [ "$node_ver" -lt 22 ]; then \
         echo "ERROR: Node $node_ver < 22, Codex/Cline require 22+"; exit 1; \
       fi
