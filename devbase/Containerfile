FROM localhost/securetty_base:latest

# =============================================================================
# securetty devbase — system packages + dev tools (cached intermediate layer)
# Rarely changes. Rebuild only when adding/removing system packages.
# =============================================================================

# Development Tools group + all system packages
RUN dnf group install -y development-tools \
    && dnf install -y --setopt=install_weak_deps=False \
        python3-lxml gnupg2 dbus-tools mesa-dri-drivers ncat awscli2 ruff iputils ffmpeg net-tools sassc python3 findutils libxml2 skopeo gsettings-desktop-schemas python3-ansible-lint xdg-utils sqlite ImageMagick socat ansible-core dnf-plugins-core yamllint python3-pytest gnome-shell dbus-daemon rpm-build util-linux glab gcc sound-theme-freedesktop python3-pip pipewire-pulseaudio mutter-devkit podman-remote iproute dconf glib2 glib2-devel nmap hostname make bind-utils man-db xz pciutils unzip lsof pulseaudio-utils mesa-libEGL nmap-ncat git-core gettext g++ gnome-extensions-app openssh-clients tree gjs python3-devel tar which golang gh python3-flake8 git sshpass \
    && dnf clean all \
    && rm -rf /var/cache/dnf

# Verify Node >= 22 (required by Codex CLI, Cline)
RUN node_ver=$(node -v | sed 's/v//' | cut -d. -f1) \
    && if [ "$node_ver" -lt 22 ]; then \
         echo "ERROR: Node $node_ver < 22, Codex/Cline require 22+"; exit 1; \
       fi
