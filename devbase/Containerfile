FROM localhost/securetty_base:latest

# =============================================================================
# securetty devbase — system packages + dev tools (cached intermediate layer)
# Rarely changes. Rebuild only when adding/removing system packages.
# =============================================================================

# Development Tools group + all system packages
RUN dnf group install -y development-tools \
    && dnf install -y --setopt=install_weak_deps=False \
        net-tools man-db gnome-shell python3-pip tar nmap golang make findutils iproute gh ansible-core gnupg2 mutter-devkit git xz gsettings-desktop-schemas gnome-extensions-app nmap-ncat pciutils mesa-dri-drivers tree ruff sshpass awscli2 libxml2 dconf pipewire-pulseaudio glab sound-theme-freedesktop dbus-tools python3-devel python3-lxml python3-ansible-lint mesa-libEGL podman-remote unzip socat ImageMagick yamllint g++ python3-flake8 sqlite git-core gcc glib2-devel rpm-build glib2 pulseaudio-utils lsof util-linux ffmpeg python3 sassc which openssh-clients bind-utils gjs python3-pytest dnf-plugins-core hostname iputils gettext ncat skopeo dbus-daemon xdg-utils \
    && dnf clean all \
    && rm -rf /var/cache/dnf

# Verify Node >= 22 (required by Codex CLI, Cline)
RUN node_ver=$(node -v | sed 's/v//' | cut -d. -f1) \
    && if [ "$node_ver" -lt 22 ]; then \
         echo "ERROR: Node $node_ver < 22, Codex/Cline require 22+"; exit 1; \
       fi
