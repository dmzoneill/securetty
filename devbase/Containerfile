FROM localhost/securetty_base:latest

# =============================================================================
# securetty devbase — system packages + dev tools (cached intermediate layer)
# Rarely changes. Rebuild only when adding/removing system packages.
# =============================================================================

# Development Tools group + all system packages
RUN dnf group install -y development-tools \
    && dnf install -y --setopt=install_weak_deps=False \
        sound-theme-freedesktop findutils man-db ruff xz hostname sassc iputils awscli2 gsettings-desktop-schemas golang dbus-tools tree git gh python3-ansible-lint python3-devel ImageMagick rpm-build python3-flake8 pipewire-pulseaudio libxml2 gnome-extensions-app dconf mutter-devkit mesa-libEGL gcc nmap pciutils yamllint python3-lxml dbus-daemon g++ mesa-dri-drivers net-tools ffmpeg python3-pytest podman-remote util-linux iproute openssh-clients python3-pip which unzip gettext nmap-ncat sshpass pulseaudio-utils gnupg2 bind-utils lsof dnf-plugins-core glib2 glab glib2-devel skopeo git-core python3 xdg-utils gnome-shell sqlite socat tar ncat gjs make ansible-core \
    && dnf clean all \
    && rm -rf /var/cache/dnf

# Verify Node >= 22 (required by Codex CLI, Cline)
RUN node_ver=$(node -v | sed 's/v//' | cut -d. -f1) \
    && if [ "$node_ver" -lt 22 ]; then \
         echo "ERROR: Node $node_ver < 22, Codex/Cline require 22+"; exit 1; \
       fi
