FROM localhost/securetty_base:latest

# =============================================================================
# securetty devbase — system packages + dev tools (cached intermediate layer)
# Rarely changes. Rebuild only when adding/removing system packages.
# =============================================================================

# Development Tools group + all system packages
RUN dnf group install -y development-tools \
    && dnf install -y --setopt=install_weak_deps=False \
        hostname net-tools python3 awscli2 gettext pulseaudio-utils util-linux python3-pytest python3-ansible-lint yamllint xdg-utils mutter-devkit glib2 g++ gh skopeo dconf unzip sassc findutils dbus-tools tar rpm-build gcc gjs tree python3-lxml gnome-shell gnome-extensions-app sshpass ruff dnf-plugins-core socat iproute pciutils glab python3-pip ImageMagick ffmpeg git-core pipewire-pulseaudio gsettings-desktop-schemas sqlite golang podman-remote python3-devel xz nmap-ncat nmap libxml2 which glib2-devel iputils python3-flake8 git man-db lsof dbus-daemon ncat mesa-libEGL bind-utils mesa-dri-drivers sound-theme-freedesktop gnupg2 openssh-clients make ansible-core \
    && dnf clean all \
    && rm -rf /var/cache/dnf

# Verify Node >= 22 (required by Codex CLI, Cline)
RUN node_ver=$(node -v | sed 's/v//' | cut -d. -f1) \
    && if [ "$node_ver" -lt 22 ]; then \
         echo "ERROR: Node $node_ver < 22, Codex/Cline require 22+"; exit 1; \
       fi
