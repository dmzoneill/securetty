FROM localhost/securetty_base:latest

RUN dnf install -y --setopt=install_weak_deps=False coreutils \
    && dnf clean all && rm -rf /var/cache/dnf

# OSV-Scanner binary (Go binary from GitHub releases)
RUN curl -fsSL https://github.com/google/osv-scanner/releases/latest/download/osv-scanner_linux_amd64 \
        -o /usr/local/bin/osv-scanner \
    && chmod +x /usr/local/bin/osv-scanner

RUN groupadd -g 1000 scanner \
    && useradd -u 1000 -g 1000 -m -s /bin/bash scanner \
    && mkdir -p /results && chown scanner:scanner /results

COPY scripts/osv-watch.sh /usr/local/bin/osv-watch.sh
RUN chmod +x /usr/local/bin/osv-watch.sh

USER scanner
WORKDIR /results

CMD ["/usr/local/bin/osv-watch.sh"]
