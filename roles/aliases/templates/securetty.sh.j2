# Main dispatch
# =============================================================================

case "${1:-help}" in
    run)              shift; cmd_run "$@" ;;
    run-work)         shift; cmd_run_work "$@" ;;
    shell)            shift; cmd_shell "$@" ;;
    setup)            shift; cmd_setup "$@" ;;
    rebuild)          shift; cmd_rebuild "$@" ;;
    rebuild-agents)   shift; cmd_rebuild_agents "$@" ;;
    up)               shift; cmd_up "$@" ;;
    down)             shift; cmd_down "$@" ;;
    egress)           shift; cmd_egress "$@" ;;
    env)              shift; cmd_env "$@" ;;
    status)           shift; cmd_status "$@" ;;
    top)              shift; cmd_top "$@" ;;
    scan)             shift; cmd_scan "$@" ;;
    volumes)          shift; cmd_volumes "$@" ;;
    clean)            shift; cmd_clean "$@" ;;
    cost)             shift; cmd_cost "$@" ;;
    preflight)        shift; cmd_preflight "$@" ;;
    logs)             shift; cmd_logs "$@" ;;
    restart)          shift; cmd_restart "$@" ;;
    exec)             shift; cmd_exec "$@" ;;
    dispatch)         shift; cmd_dispatch "$@" ;;
    jobs)             shift; cmd_jobs "$@" ;;
    watch)            shift; cmd_watch "$@" ;;
    dashboard)        shift; cmd_dashboard "$@" ;;
    alerts)           shift; cmd_alerts "$@" ;;
    retro)            shift; cmd_retro "$@" ;;
    eval)             shift; cmd_eval "$@" ;;
    daemon)           shift; cmd_daemon "$@" ;;
