#!/bin/bash
# {{ ansible_managed }}
# securetty — sandboxed AI development environment CLI
set -euo pipefail

SECURETTY_DIR="$(cd "$(dirname "$0")" && pwd)"
SECURETTY_IMAGE="${SECURETTY_IMAGE:-securetty_dev}"
export SECURETTY_MCP_SKILLS_DIR="${SECURETTY_MCP_SKILLS_DIR:-{{ securetty_mcp_skills_dir }}}"
export SECURETTY_WORK_DIR="${SECURETTY_WORK_DIR:-{{ securetty_work_dir }}}"

# Source session outcome logging helpers
# shellcheck source=roles/aliases/files/securetty-outcomes.sh
[ -f "$SECURETTY_DIR/roles/aliases/files/securetty-outcomes.sh" ] && \
    source "$SECURETTY_DIR/roles/aliases/files/securetty-outcomes.sh"

# =============================================================================
# Internal functions
# =============================================================================

_ensure_dirs() {
    mkdir -p {% for dir in securetty_agent_config_dirs %}~/{{ dir }} {% endfor %}2>/dev/null || true
}

_generate_env() {
    local env_file="$SECURETTY_DIR/.env"
    local max_age=300
    if [ -f "$env_file" ]; then
        local file_age=$(( $(date +%s) - $(stat -c %Y "$env_file") ))
        if [ "$file_age" -lt "$max_age" ]; then
            : # skip regeneration, .env is fresh (<5min)
        else
            bash "$SECURETTY_DIR/scripts/generate-env.sh" "$env_file" 2>/dev/null
        fi
    else
        bash "$SECURETTY_DIR/scripts/generate-env.sh" "$env_file" 2>/dev/null
    fi
    # Only extract non-secret vars needed for _run_personal/_run_work
    # Never source full .env into shell (leaks secrets to /proc/PID/environ)
    OMNIROUTE_API_KEY=$(grep -m1 '^OMNIROUTE_API_KEY=' "$env_file" 2>/dev/null | cut -d= -f2-)
    ANTHROPIC_VERTEX_PROJECT_ID=$(grep -m1 '^ANTHROPIC_VERTEX_PROJECT_ID=' "$env_file" 2>/dev/null | cut -d= -f2-)
    GOOGLE_CLOUD_PROJECT=$(grep -m1 '^GOOGLE_CLOUD_PROJECT=' "$env_file" 2>/dev/null | cut -d= -f2-)
    GOOGLE_CLOUD_LOCATION=$(grep -m1 '^GOOGLE_CLOUD_LOCATION=' "$env_file" 2>/dev/null | cut -d= -f2-)
    export OMNIROUTE_API_KEY ANTHROPIC_VERTEX_PROJECT_ID GOOGLE_CLOUD_PROJECT GOOGLE_CLOUD_LOCATION
}

_ensure_ssh_agent() {
    if [ ! -S "/run/user/$(id -u)/securetty-ssh-agent.sock" ]; then
        bash "$SECURETTY_DIR/scripts/ssh-agent-restricted.sh" start 2>/dev/null
    fi
}

_ensure_services() {
    if ! _container_running securetty-omniroute || ! _container_running securetty-headroom || ! _container_running securetty-creds; then
        echo "Starting services..."
        (cd "$SECURETTY_DIR" && {{ securetty_compose_cmd }} up -d --no-build 2>/dev/null) || true
        sleep 1
    fi
}

_ensure_url_relay() {
    if [ ! -S "/run/user/$(id -u)/securetty-open.sock" ]; then
        bash "$SECURETTY_DIR/scripts/open-relay-host.sh" start &
        disown
        sleep 0.3
    fi
}

_ensure_egress() {
    local netns="/run/user/$(id -u)/containers/networks/rootless-netns/rootless-netns"
    [ -e "$netns" ] || return 0
    local has_table
    has_table=$({{ securetty_podman_cmd }} unshare nsenter --net="$netns" nft list tables 2>/dev/null | grep -c securetty_egress || true)
    if [ "$has_table" -eq 0 ]; then
        local egress_script="$SECURETTY_DIR/scripts/securetty-egress.sh"
        local resolve_script="$SECURETTY_DIR/scripts/resolve-egress.sh"
        if [ -x "$egress_script" ]; then
            {{ securetty_podman_cmd }} unshare nsenter --net="$netns" bash "$egress_script" 2>/dev/null
            [ -x "$resolve_script" ] && { bash "$resolve_script" &>/dev/null & disown; }
        fi
    else
        # Table exists but IPs may be stale — refresh in background
        local resolve_script="$SECURETTY_DIR/scripts/resolve-egress.sh"
        [ -x "$resolve_script" ] && { bash "$resolve_script" &>/dev/null & disown; }
    fi
}

_patch_dns() {
    local conf="/run/user/$(id -u)/containers/networks/aardvark-dns/{{ securetty_network_name }}"
    [ -f "$conf" ] || return 0
    if grep -q '8.8.8.8,8.8.4.4' "$conf" 2>/dev/null; then
        sed -i 's/8.8.8.8,8.8.4.4/169.254.1.1/g' "$conf"
        sed -i 's/169.254.1.1,169.254.1.1/169.254.1.1/g' "$conf"
        local pid
        pid=$(cat "/run/user/$(id -u)/containers/networks/aardvark-dns/aardvark.pid" 2>/dev/null)
        [ -n "$pid" ] && kill -HUP "$pid" 2>/dev/null
    fi
}

_preflight() {
    local errors=0 warnings=0
    echo "=== Securetty Preflight ==="

    # Hard checks (fail if missing)
    if ! {{ securetty_podman_cmd }} info &>/dev/null; then
        echo "  FAIL: podman not running"
        errors=$((errors + 1))
    else
        echo "  OK: podman"
    fi

    if ! {{ securetty_podman_cmd }} image exists securetty_dev 2>/dev/null; then
        echo "  FAIL: securetty_dev image not built (run securetty rebuild)"
        errors=$((errors + 1))
    else
        echo "  OK: dev image"
    fi

    if ! {{ securetty_podman_cmd }} network exists {{ securetty_network_name }} 2>/dev/null; then
        echo "  FAIL: securetty network not created (run securetty setup)"
        errors=$((errors + 1))
    else
        echo "  OK: network"
    fi

    # Service checks
    for svc in securetty-omniroute securetty-headroom securetty-creds; do
        if [ "$({{ securetty_podman_cmd }} inspect "$svc" --format '{% raw %}{{.State.Running}}{% endraw %}' 2>/dev/null)" = "true" ]; then
            echo "  OK: $svc"
        else
            echo "  WARN: $svc not running"
            warnings=$((warnings + 1))
        fi
    done

    # SSH agent
    if [ -S "/run/user/$(id -u)/securetty-ssh-agent.sock" ]; then
        echo "  OK: SSH agent"
        if [ -f "/run/user/$(id -u)/securetty-ssh-token" ]; then
            echo "  OK: SSH proxy token"
        else
            echo "  WARN: SSH proxy token missing"
            warnings=$((warnings + 1))
        fi
    else
        echo "  WARN: SSH agent not running"
        warnings=$((warnings + 1))
    fi

    # Env file
    if [ -f "$SECURETTY_DIR/.env" ]; then
        local key_count
        key_count=$(grep -c '=' "$SECURETTY_DIR/.env" 2>/dev/null || echo 0)
        echo "  OK: .env ($key_count keys)"
    else
        echo "  WARN: .env not generated (run securetty env)"
        warnings=$((warnings + 1))
    fi

    # Disk space
    local avail
    avail=$(df -BG --output=avail "$SECURETTY_DIR" 2>/dev/null | tail -1 | tr -d ' G')
    if [ "${avail:-0}" -lt 5 ]; then
        echo "  WARN: low disk space (${avail}G available)"
        warnings=$((warnings + 1))
    else
        echo "  OK: disk (${avail}G available)"
    fi

    echo ""
    echo "Results: $errors errors, $warnings warnings"
    [ "$errors" -eq 0 ] && return 0 || return 1
}

_extract_workdir() {
    _SECURETTY_WORKDIR="$(pwd)"
    _SECURETTY_ARGS=()
    for arg in "$@"; do
        if [ -d "$arg" ] && [ "$_SECURETTY_WORKDIR" = "$(pwd)" ]; then
            _SECURETTY_WORKDIR="$(realpath "$arg")"
        else
            _SECURETTY_ARGS+=("$arg")
        fi
    done
}

_convert_timeout_to_seconds() {
    local val="$1"
    local num="${val%[smhd]}"
    local unit="${val##*[0-9]}"
    case "$unit" in
        s|"") echo "$num" ;;
        m)    echo $((num * 60)) ;;
        h)    echo $((num * 3600)) ;;
        d)    echo $((num * 86400)) ;;
        *)    echo "$num" ;;
    esac
}

_validate_agent() {
    local agent="$1"
    local valid_agents="{{ securetty_agents | map(attribute='name') | join(' ') }}"
    for a in $valid_agents; do
        [ "$a" = "$agent" ] && return 0
    done
    echo "ERROR: unknown agent '${agent}'" >&2
    echo "Available agents: ${valid_agents// /, }" >&2
    return 1
}

_parse_run_flags() {
    _SECURETTY_MAX_TURNS=""
    _SECURETTY_TIMEOUT=""
    _SECURETTY_PROMPT=""
    _SECURETTY_CLEANUP="remove"
    _SECURETTY_EXTRA_VOLUMES=()
    _SECURETTY_IMAGE_OVERRIDE=""
    _SECURETTY_READ_MODE=""
    _SECURETTY_FLAGPARSED_ARGS=()
    while [ $# -gt 0 ]; do
        case "$1" in
            --max-turns)
                if ! [[ "${2:-}" =~ ^[0-9]+$ ]]; then
                    echo "ERROR: --max-turns requires a positive integer" >&2
                    return 1
                fi
                _SECURETTY_MAX_TURNS="$2"
                shift 2
                ;;
            --timeout)
                if ! [[ "${2:-}" =~ ^[0-9]+[smhd]?$ ]]; then
                    echo "ERROR: --timeout requires a value like 30s, 5m, 1h, or 1d" >&2
                    return 1
                fi
                _SECURETTY_TIMEOUT="$2"
                shift 2
                ;;
            -p|--prompt)
                _SECURETTY_PROMPT="${2:-}"
                shift 2
                ;;
            --cleanup)
                _SECURETTY_CLEANUP="${2:-remove}"
                shift 2
                ;;
            --image)
                _SECURETTY_IMAGE_OVERRIDE="${2:-}"
                shift 2
                ;;
            --read)
                _SECURETTY_READ_MODE=1
                shift
                ;;
            -v)
                _SECURETTY_EXTRA_VOLUMES+=("-v" "${2:-}")
                shift 2
                ;;
            *)
                _SECURETTY_FLAGPARSED_ARGS+=("$1")
                shift
                ;;
        esac
    done
}

_build_envfile() {
    local envfile
    envfile=$(umask 077; mktemp /run/user/$(id -u)/securetty-env.XXXXXX) || { echo "ERROR: mktemp failed" >&2; return 1; }
    [ -n "$envfile" ] || { echo "ERROR: empty envfile path" >&2; return 1; }

    # Zero-secret agent env — only OMNIROUTE_API_KEY + non-secret config
    grep -E '^OMNIROUTE_API_KEY=' "$SECURETTY_DIR/.env" >> "$envfile" 2>/dev/null || true
    grep -E '^(CLAUDE_CODE_USE_VERTEX|ANTHROPIC_VERTEX_PROJECT_ID|GOOGLE_CLOUD_PROJECT|GOOGLE_CLOUD_LOCATION|CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC)=' "$SECURETTY_DIR/.env" >> "$envfile" 2>/dev/null || true

    cat >> "$envfile" <<ENVEOF
HOME={{ securetty_home }}
USER={{ securetty_user }}
SSH_AUTH_SOCK=/run/ssh-agent.sock
GPG_AGENT_INFO=/run/gpg-agent.sock
XDG_RUNTIME_DIR=/run/user/$(id -u)
PULSE_SERVER=unix:/run/user/$(id -u)/pulse/native
NODE_ENV=development
npm_config_ignore_scripts=true
NODE_EXTRA_CA_CERTS=/certs/ca.crt
npm_config_cache={{ securetty_home }}/.npm
npm_config_prefix={{ securetty_home }}/.npm-global
CARGO_HOME={{ securetty_home }}/.cargo
GOPATH={{ securetty_home }}/go
GOBIN={{ securetty_home }}/go/bin
PYTHONUSERBASE={{ securetty_home }}/.local
PIP_USER=1
PATH={{ securetty_home }}/.npm-global/bin:{{ securetty_home }}/go/bin:{{ securetty_home }}/.cargo/bin:{{ securetty_home }}/.local/bin:/usr/local/bin:/usr/bin:/bin
OMNIROUTE_BASE_URL=http://securetty-omniroute:4000
HEADROOM_URL=http://securetty-headroom:8787
OLLAMA_HOST=http://securetty-ollama:11434
CLOUDCLI_URL=http://securetty-cloudcli:3001
ENVEOF

    [ -n "${_SECURETTY_MAX_TURNS:-}" ] && echo "SECURETTY_MAX_TURNS=${_SECURETTY_MAX_TURNS}" >> "$envfile"
    [ -n "${_SECURETTY_TIMEOUT:-}" ] && echo "SECURETTY_TIMEOUT=${_SECURETTY_TIMEOUT}" >> "$envfile"

    if [ -n "${_SECURETTY_EXTRA_ENVLINES+x}" ]; then
        printf '%s\n' "${_SECURETTY_EXTRA_ENVLINES[@]}" >> "$envfile"
    fi

    echo "$envfile"
}

_run() {
    local agent="$1"
    shift

    _ensure_dirs
    _generate_env
    _ensure_ssh_agent
    _ensure_services
    _ensure_url_relay

    local envfile
    envfile=$(_build_envfile) || return 1
    trap "rm -f '$envfile'" EXIT INT TERM

    if [ -z "${GPG_AGENT_EXTRA_SOCK:-}" ]; then
        echo "WARN: GPG_AGENT_EXTRA_SOCK unset — commit signing disabled in container" >&2
    fi

    _SSH_TOKEN_MOUNT=""
    [ -f "/run/user/$(id -u)/securetty-ssh-token" ] && _SSH_TOKEN_MOUNT="-v /run/user/$(id -u)/securetty-ssh-token:/run/ssh-token:ro"

    _ensure_egress 2>/dev/null
    _patch_dns 2>/dev/null
    { sleep 2 && _patch_dns; } &>/dev/null & disown

    local _run_start_ts
    _run_start_ts=$(date +%s)

    # Apply image override if set
    local _image="${SECURETTY_IMAGE}"
    [ -n "${_SECURETTY_IMAGE_OVERRIDE:-}" ] && _image="$_SECURETTY_IMAGE_OVERRIDE"

    # Container lifecycle: --rm or persist
    local _rm_flag="--rm"
    [ "${_SECURETTY_CLEANUP:-remove}" = "keep" ] && _rm_flag=""

    # Interactive vs prompt mode
    local _it_flags="-it"
    local _extra_agent_args=()
    if [ -n "${_SECURETTY_PROMPT:-}" ]; then
        _it_flags="-i"
        _extra_agent_args+=("--prompt" "$_SECURETTY_PROMPT")
    fi

    # Build the podman command
    local _podman_cmd=(
        {{ securetty_podman_cmd }} run ${_rm_flag} ${_it_flags}
        --env-file "$envfile"
        --network {{ securetty_network_name }}
        --name "securetty-${agent}-$$"
        --hostname "securetty-${agent}"
        --user "$(id -u):$(id -g)"
        --userns=keep-id
        --cap-drop ALL
        --security-opt no-new-privileges:true
        --security-opt label=disable
        --security-opt "mask=/proc/mounts:/proc/self/mounts:/proc/self/mountinfo:/proc/cmdline:/proc/partitions:/proc/diskstats:/proc/version:/sys/class/dmi"
        --read-only
        --pids-limit 4096
        -v "{{ securetty_home }}/src:{{ securetty_home }}/src"
        -v "{{ securetty_home }}/.gitconfig:{{ securetty_home }}/.gitconfig:ro"
        -v "{{ securetty_home }}/.gnupg/pubring.kbx:{{ securetty_home }}/.gnupg/pubring.kbx:ro"
        -v "{{ securetty_home }}/.gnupg/trustdb.gpg:{{ securetty_home }}/.gnupg/trustdb.gpg:ro"
        -v "/run/user/$(id -u)/securetty-ssh-agent.sock:/run/ssh-agent.sock:ro"
        ${_SSH_TOKEN_MOUNT:-}
        -v "{{ securetty_home }}/.ssh/config:{{ securetty_home }}/.ssh/config:ro"
        -v "{{ securetty_home }}/.ssh/known_hosts:{{ securetty_home }}/.ssh/known_hosts:ro"
        -v "{{ securetty_home }}/.claude.json:{{ securetty_home }}/.claude.json"
{% for dir in securetty_agent_config_dirs %}
        -v "{{ securetty_home }}/{{ dir }}:{{ securetty_home }}/{{ dir }}"
{% endfor %}
        -v "{{ securetty_home }}/bin:{{ securetty_home }}/bin:ro"
        -v "{{ securetty_home }}/.kube:{{ securetty_home }}/.kube"
        -v "{{ securetty_home }}/.aws:{{ securetty_home }}/.aws:ro"
        -v "{{ securetty_home }}/Downloads:{{ securetty_home }}/Downloads"
        -v "{{ securetty_home }}/.local/bin:{{ securetty_home }}/.local/bin:ro"
        -v "{{ securetty_home }}/.local/share/virtualenvs:{{ securetty_home }}/.local/share/virtualenvs"
        -v "/run/user/$(id -u):/run/user/$(id -u)"
        -v "${GPG_AGENT_EXTRA_SOCK:-/dev/null}:/run/gpg-agent.sock:ro"
        -v "$SECURETTY_DIR/certs:/certs:ro"
        --tmpfs /tmp:size=512M
        -v securetty-npm-cache:{{ securetty_home }}/.npm
        -v securetty-pip-cache:{{ securetty_home }}/.cache/pip
        -v securetty-uv-cache:{{ securetty_home }}/.cache/uv
        -v securetty-cargo-cache:{{ securetty_home }}/.cargo
        -v securetty-go-cache:{{ securetty_home }}/go
        -v securetty-pip-user:{{ securetty_home }}/.local/lib
        -v securetty-npm-global:{{ securetty_home }}/.npm-global
        -v securetty-usr-local:/usr/local
        --tmpfs {{ securetty_home }}/.cache/mesa_shader_cache:size=128M
        "${_SECURETTY_EXTRA_VOLUMES[@]}"
        -w "${_SECURETTY_WORKDIR:-$(pwd)}"
        "$_image"
        "$agent" "${_extra_agent_args[@]}" "$@"
    )

    # Execute with optional timeout enforcement
    local _run_exit_code=0
    if [ -n "${_SECURETTY_TIMEOUT:-}" ]; then
        local _timeout_seconds
        _timeout_seconds=$(_convert_timeout_to_seconds "$_SECURETTY_TIMEOUT")
        timeout --signal=TERM --kill-after=30 "$_timeout_seconds" "${_podman_cmd[@]}" || _run_exit_code=$?
    else
        "${_podman_cmd[@]}" || _run_exit_code=$?
    fi

    rm -f "$envfile"

    # Calculate session duration and log outcome
    local _run_end_ts _run_duration
    _run_end_ts=$(date +%s)
    _run_duration=$(( _run_end_ts - _run_start_ts ))

    if type -t _log_session_outcome &>/dev/null; then
        _log_session_outcome "$agent" "$_run_exit_code" "$_run_duration" "${_SECURETTY_WORKDIR:-$(pwd)}"
    fi

    # Log session cost (Claude Code writes cost to ~/.claude/projects/*/usage.json)
    local cost_dir="{{ securetty_home }}/.securetty/cost"
    mkdir -p "$cost_dir" 2>/dev/null || true
    local cost_log="$cost_dir/$(date +%Y-%m-%d).jsonl"
    local session_end
    session_end=$(date -u +%FT%TZ)
    echo "{\"agent\":\"$agent\",\"end\":\"$session_end\",\"mode\":\"${_SECURETTY_MODE:-personal}\",\"exit_code\":${_run_exit_code},\"duration\":${_run_duration}}" >> "$cost_log" 2>/dev/null || true

    return $_run_exit_code
}

# =============================================================================
# Mode wrappers
# =============================================================================

_run_work() {
    local agent="$1"
    shift
    _SECURETTY_EXTRA_ENVLINES=(
        "CLAUDE_CODE_USE_VERTEX=1"
{% raw %}
        "ANTHROPIC_VERTEX_PROJECT_ID=${ANTHROPIC_VERTEX_PROJECT_ID:-}"
        "GOOGLE_CLOUD_PROJECT=${GOOGLE_CLOUD_PROJECT:-}"
        "GOOGLE_CLOUD_LOCATION=${GOOGLE_CLOUD_LOCATION:-}"
{% endraw %}
        "CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC=1"
        "ANTHROPIC_BASE_URL="
        "GOOGLE_APPLICATION_CREDENTIALS={{ securetty_home }}/.config/gcloud/application_default_credentials.json"
    )
    [ "${_SECURETTY_READ_MODE:-}" = "1" ] && _SECURETTY_EXTRA_ENVLINES+=("SECURETTY_MODE=read")
    _SECURETTY_MODE="work"
    _run "$agent" "$@"
}

_run_personal() {
    local agent="$1"
    shift
{% raw %}
    local omni_key="${OMNIROUTE_API_KEY:-}"
{% endraw %}
    _SECURETTY_EXTRA_ENVLINES=(
{% raw %}
        "CLAUDE_CODE_USE_VERTEX="
        "ANTHROPIC_BASE_URL=http://securetty-omniroute:4000"
        "ANTHROPIC_API_KEY=${omni_key}"
        "OPENAI_BASE_URL=http://securetty-omniroute:4000/v1"
        "OPENAI_API_KEY=${omni_key}"
        "GEMINI_API_KEY="
        "GOOGLE_API_KEY=${omni_key}"
        "OPENAI_API_BASE=http://securetty-omniroute:4000/v1"
{% endraw %}
    )
    [ "${_SECURETTY_READ_MODE:-}" = "1" ] && _SECURETTY_EXTRA_ENVLINES+=("SECURETTY_MODE=read")
    _SECURETTY_MODE="personal"
    _run "$agent" "$@"
}

# =============================================================================
# Subcommands
# =============================================================================

_prepare_run() {
    if [ $# -eq 0 ]; then
        echo "Usage: securetty run|run-work <agent> [--max-turns N] [--timeout T] [workdir]" >&2
        echo "Available agents: {{ securetty_agents | map(attribute='name') | join(', ') }}" >&2
        return 1
    fi
    _parse_run_flags "$@" || return 1
    _extract_workdir "${_SECURETTY_FLAGPARSED_ARGS[@]}"
    _validate_agent "${_SECURETTY_ARGS[0]}" || return 1
    if [ -n "$_SECURETTY_WORKDIR" ] && [ ! -d "$_SECURETTY_WORKDIR" ]; then
        echo "ERROR: workdir does not exist: $_SECURETTY_WORKDIR" >&2
        return 1
    fi
}

cmd_run() {      _prepare_run "$@" && _run_personal "${_SECURETTY_ARGS[@]}"; }
cmd_run_work() { _prepare_run "$@" && _run_work "${_SECURETTY_ARGS[@]}"; }

cmd_shell() {
    _extract_workdir "$@"
    _run_personal /bin/bash "${_SECURETTY_ARGS[@]}"
}

_ansible() {
    (cd "$SECURETTY_DIR" && ansible-playbook "$@")
}

_container_running() {
    [ "$({{ securetty_podman_cmd }} inspect "$1" --format '{% raw %}{{.State.Running}}{% endraw %}' 2>/dev/null)" = "true" ]
}

_container_status() {
    {{ securetty_podman_cmd }} inspect "$1" --format '{% raw %}{{.State.Status}}{% endraw %}' 2>/dev/null || echo "missing"
}

cmd_setup() {    _ansible site.yml "$@"; }
cmd_build() {    _ansible site.yml --tags prereqs,build "$@"; }
cmd_rebuild() {  _ansible site.yml --tags prereqs,build -e securetty_force_rebuild=true "$@"; }
cmd_rebuild_agents() { _ansible site.yml --tags prereqs,build -e securetty_force_rebuild=true -e securetty_skip_devbase=true -e securetty_dev_only=true "$@"; }
cmd_up() {       _ansible site.yml --tags prereqs,up "$@"; }
cmd_egress() {   _ansible site.yml --tags prereqs,egress "$@"; }
cmd_omniroute() { _ansible site.yml --tags prereqs,omniroute "$@"; }
cmd_ollama() {   _ansible site.yml --tags prereqs,ollama "$@"; }
cmd_aliases() {  _ansible site.yml --tags prereqs,aliases "$@"; }
cmd_certs() {    _ansible site.yml --tags prereqs,certs "$@"; }

cmd_down() {
    (cd "$SECURETTY_DIR" && {{ securetty_compose_cmd }} down)
}

cmd_nuke() {
    echo "This will remove ALL securetty containers AND volumes (cached packages, models, data)."
    echo "Press Ctrl-C to cancel, or Enter to continue."
    read -r
    (cd "$SECURETTY_DIR" && {{ securetty_compose_cmd }} down -v)
}

cmd_audit() {
    {{ securetty_podman_cmd }} run --rm securetty_dev bash -c \
        'echo "=== npm audit ===" && npm audit --audit-level=high -g 2>/dev/null; echo "=== pip-audit ===" && pip-audit --desc 2>/dev/null || true'
}

cmd_test() {
    cd "$SECURETTY_DIR"
    echo "=== shellcheck ==="
    find roles/ scripts/ -name '*.sh' -not -path '*/templates/*' 2>/dev/null | xargs shellcheck -x -S warning 2>/dev/null || true
    echo "=== yamllint ==="
    yamllint -d '{extends: default, rules: {line-length: disable, truthy: disable}}' group_vars/ roles/*/tasks/ site.yml scan.yml migrate.yml 2>/dev/null || true
    echo "=== ansible-lint ==="
    ansible-lint site.yml 2>/dev/null || true
}

cmd_migrate() {
    echo "This will REMOVE AI agents from the host. Destructive operation."
    echo "Press Ctrl-C to cancel, or Enter to continue."
    read -r
    _ansible migrate.yml "$@"
}

cmd_env() {
    _ansible site.yml --tags prereqs,env "$@"
    local env_file="$SECURETTY_DIR/.env"
    if [ -f "$env_file" ]; then
        local _missing=0
        for key in OMNIROUTE_API_KEY; do
            if ! grep -q "^${key}=.\+" "$env_file" 2>/dev/null; then
                echo "WARN: ${key} missing or empty in .env" >&2
                _missing=$((_missing + 1))
            fi
        done
        local _count
        _count=$(grep -c '=' "$env_file" 2>/dev/null || echo 0)
        echo "Generated .env with ${_count} keys (${_missing} missing)"
    else
        echo "ERROR: .env was not generated" >&2
        return 1
    fi
}

cmd_scan() {
    local mode="${1:-summary}"
    if ! _container_running securetty-guarddog && ! _container_running securetty-osv-scanner; then
        echo "Scanners not deployed. Run 'securetty up' first." >&2
        return 1
    fi
    case "$mode" in
        alerts)
            echo "=== GuardDog Alerts ==="
            {{ securetty_podman_cmd }} exec securetty-guarddog cat /results/alerts.log 2>/dev/null || echo "No alerts"
            echo ""
            echo "=== OSV-Scanner Alerts ==="
            {{ securetty_podman_cmd }} exec securetty-osv-scanner cat /results/alerts.log 2>/dev/null || echo "No alerts"
            ;;
        logs)
            echo "=== GuardDog Log ==="
            {{ securetty_podman_cmd }} logs --tail 50 securetty-guarddog 2>/dev/null || echo "Not running"
            echo ""
            echo "=== OSV-Scanner Log ==="
            {{ securetty_podman_cmd }} logs --tail 50 securetty-osv-scanner 2>/dev/null || echo "Not running"
            ;;
        *)
            echo "=== Scanner Status ==="
            {{ securetty_podman_cmd }} ps --format "{% raw %}{{.Names}}\t{{.Status}}{% endraw %}" --filter name=guarddog --filter name=osv 2>/dev/null || echo "Not running"
            echo ""
            echo "=== Recent Activity ==="
            {{ securetty_podman_cmd }} logs --tail 5 securetty-guarddog 2>/dev/null || true
            {{ securetty_podman_cmd }} logs --tail 5 securetty-osv-scanner 2>/dev/null || true
            echo ""
            local gd_alerts osv_alerts
            gd_alerts=$({{ securetty_podman_cmd }} exec securetty-guarddog wc -l /results/alerts.log 2>/dev/null | awk '{print $1}' || echo "0")
            osv_alerts=$({{ securetty_podman_cmd }} exec securetty-osv-scanner wc -l /results/alerts.log 2>/dev/null | awk '{print $1}' || echo "0")
            echo "GuardDog alerts: ${gd_alerts:-0}"
            echo "OSV-Scanner alerts: ${osv_alerts:-0}"
            [ "${gd_alerts:-0}" != "0" ] || [ "${osv_alerts:-0}" != "0" ] && echo "Run 'securetty scan alerts' for details"
            ;;
    esac
}

cmd_volumes() {
    _show_volume() {
        local vol="$1"
        local mountpoint
        mountpoint=$({{ securetty_podman_cmd }} volume inspect "$vol" --format '{% raw %}{{.Mountpoint}}{% endraw %}' 2>/dev/null)
        if [ -n "$mountpoint" ]; then
            local du_size
            du_size=$(du -sh "$mountpoint" 2>/dev/null | awk '{print $1}' || echo "?")
            printf "  %-30s %s\n" "$vol" "$du_size"
        else
            printf "  %-30s %s\n" "$vol" "(not created)"
        fi
    }

    local _all_vols _total=0
    _all_vols=$({{ securetty_podman_cmd }} volume ls --format '{% raw %}{{.Name}}{% endraw %}' 2>/dev/null | grep -E 'securetty|guarddog|osv|headroom|cloudcli|ollama' | sort)

    if [ -z "$_all_vols" ]; then
        echo "No securetty volumes found."
        return 0
    fi

    echo "=== Package Volumes ==="
    echo "$_all_vols" | grep -E '^securetty-' | while read -r vol; do _show_volume "$vol"; _total=$((_total+1)); done
    echo ""
    echo "=== Scanner Volumes ==="
    echo "$_all_vols" | grep -E 'guarddog|osv' | while read -r vol; do _show_volume "$vol"; done
    echo ""
    echo "=== Service Volumes ==="
    echo "$_all_vols" | grep -E 'headroom|cloudcli|ollama' | while read -r vol; do _show_volume "$vol"; done
}

cmd_clean() {
    local _force=0
    [ "${1:-}" = "--yes" ] || [ "${1:-}" = "-y" ] && _force=1

    echo "=== Orphaned containers ==="
    local orphans
    orphans=$({{ securetty_podman_cmd }} ps -a --format '{% raw %}{{.Names}}{% endraw %}' --filter status=exited | grep securetty || true)
    if [ -n "$orphans" ]; then
        echo "$orphans"
        echo "Removing..."
        echo "$orphans" | xargs {{ securetty_podman_cmd }} rm -f 2>/dev/null || true
    else
        echo "None"
    fi
    echo ""
    echo "=== Dangling images ==="
    {{ securetty_podman_cmd }} image prune -f 2>/dev/null | tail -1 || echo "None"
    echo ""
    echo "=== Stale env files ==="
    local stale
    stale=$(find /run/user/$(id -u)/ -name 'securetty-env.*' -mmin +60 2>/dev/null || true)
    if [ -n "$stale" ]; then
        echo "$stale"
        echo "Removing..."
        echo "$stale" | xargs rm -f 2>/dev/null || true
    else
        echo "None"
    fi
    echo ""
    echo "=== Orphaned volumes ==="
    local orphan_vols
    orphan_vols=$({{ securetty_podman_cmd }} volume ls --format '{% raw %}{{.Name}}{% endraw %}' 2>/dev/null | grep securetty | while read -r vol; do
        {{ securetty_podman_cmd }} volume inspect "$vol" --format '{% raw %}{{.Containers}}{% endraw %}' 2>/dev/null | grep -q '^\[\]$' && echo "$vol"
    done || true)
    if [ -n "$orphan_vols" ]; then
        echo "$orphan_vols"
        if [ "$_force" -eq 1 ]; then
            echo "Removing..."
            echo "$orphan_vols" | xargs {{ securetty_podman_cmd }} volume rm 2>/dev/null || true
        else
            echo "Run 'securetty clean --yes' to remove orphaned volumes"
        fi
    else
        echo "None"
    fi
}

cmd_cost() {
    command -v jq &>/dev/null || { echo "jq required for cost reports. Install: dnf install jq"; return 1; }
    local cost_dir="{{ securetty_home }}/.securetty/cost"
    local stats_cache="{{ securetty_home }}/.claude/stats-cache.json"
    local period="${1:-today}"

    _cost_summary() {
        local files=("$@")
        local total_sessions=0 total_duration=0
        local _tmpfile
        _tmpfile=$(mktemp)
        for file in "${files[@]}"; do
            [ -f "$file" ] || continue
            cat "$file" >> "$_tmpfile"
            local c
            c=$(wc -l < "$file")
            total_sessions=$((total_sessions + c))
        done

        echo "Sessions: $total_sessions"

        if [ "$total_sessions" -gt 0 ]; then
            total_duration=$(jq -s '[.[].duration // 0] | add' "$_tmpfile" 2>/dev/null || echo 0)
            local hours=$((total_duration / 3600))
            local mins=$(( (total_duration % 3600) / 60 ))
            echo "Total duration: ${hours}h ${mins}m"
            echo ""
            echo "By agent:"
            jq -r '.agent' "$_tmpfile" 2>/dev/null | sort | uniq -c | sort -rn
            echo ""
            echo "By mode:"
            jq -r '.mode' "$_tmpfile" 2>/dev/null | sort | uniq -c | sort -rn
            echo ""
            echo "Duration by agent:"
            jq -r '[.agent, (.duration // 0 | tostring)] | join("\t")' "$_tmpfile" 2>/dev/null | \
                awk -F'\t' '{dur[$1]+=$2} END {for (a in dur) printf "  %-20s %dh %dm\n", a, dur[a]/3600, (dur[a]%3600)/60}' | sort -k2 -rn
        fi

        rm -f "$_tmpfile"
    }

    _claude_stats() {
        [ -f "$stats_cache" ] || return
        echo ""
        echo "=== Claude Code Activity ==="
        local _dates="$1"
        jq -r --arg dates "$_dates" '
            .dailyActivity[]
            | select(.date as $d | $dates | split(",") | index($d))
            | "\(.date)\t\(.messageCount) msgs, \(.sessionCount) sessions, \(.toolCallCount) tool calls"
        ' "$stats_cache" 2>/dev/null | while IFS=$'\t' read -r d info; do
            printf "  %s: %s\n" "$d" "$info"
        done
    }

    case "$period" in
        today)
            echo "=== Today ($(date +%Y-%m-%d)) ==="
            local file="$cost_dir/$(date +%Y-%m-%d).jsonl"
            if [ -f "$file" ]; then
                _cost_summary "$file"
            else
                echo "No sessions today."
            fi
            _claude_stats "$(date +%Y-%m-%d)"
            ;;
        week)
            echo "=== Last 7 days ==="
            local _files=() _dates=""
            for i in $(seq 0 6); do
                local d
                d=$(date -d "$i days ago" +%Y-%m-%d)
                _files+=("$cost_dir/${d}.jsonl")
                [ -n "$_dates" ] && _dates="${_dates},"
                _dates="${_dates}${d}"
            done
            _cost_summary "${_files[@]}"
            _claude_stats "$_dates"
            ;;
        all)
            echo "=== All time ==="
            local _files=()
            for file in "$cost_dir"/*.jsonl; do
                [ -f "$file" ] && _files+=("$file")
            done
            if [ ${#_files[@]} -gt 0 ]; then
                _cost_summary "${_files[@]}"
            else
                echo "No cost data yet."
            fi
            ;;
        *)
            echo "Usage: securetty cost [today|week|all]"
            ;;
    esac
}

cmd_preflight() {
    _preflight
}

cmd_status() {
    local G='\033[0;32m' Y='\033[0;33m' R='\033[0;31m' W='\033[1;37m' N='\033[0m'

    source "$SECURETTY_DIR/scripts/securetty-splash.sh"

    # Gather data
    local running healthy total_containers
    running=$({{ securetty_podman_cmd }} ps --format '{% raw %}{{.Names}}{% endraw %}' 2>/dev/null | grep -c securetty || echo 0)
    healthy=$({{ securetty_podman_cmd }} ps --format '{% raw %}{{.Status}}{% endraw %}' --filter name=securetty 2>/dev/null | grep -c healthy || echo 0)
    total_containers=$({{ securetty_podman_cmd }} ps -a --format '{% raw %}{{.Names}}{% endraw %}' 2>/dev/null | grep -c securetty || echo 0)

    local subnet
    subnet=$({{ securetty_podman_cmd }} network inspect {{ securetty_network_name }} --format '{% raw %}{{range .Subnets}}{{.Subnet}}{{end}}{% endraw %}' 2>/dev/null || echo "none")

    local egress_ips
    egress_ips=$({{ securetty_podman_cmd }} unshare nsenter --net="/run/user/$(id -u)/containers/networks/rootless-netns/rootless-netns" \
        nft list set inet securetty_egress allowed_ipv4 2>/dev/null | grep -c ',' || echo "0")

    local dns_status="patched (169.254.1.1)"
    grep -q '8.8.8.8' "/run/user/$(id -u)/containers/networks/aardvark-dns/{{ securetty_network_name }}" 2>/dev/null && dns_status="UNPATCHED (8.8.8.8)"

    local gd_status osv_status
    gd_status=$({{ securetty_podman_cmd }} inspect securetty-guarddog --format '{% raw %}{{.State.Status}}{% endraw %}' 2>/dev/null || echo "off")
    osv_status=$({{ securetty_podman_cmd }} inspect securetty-osv-scanner --format '{% raw %}{{.State.Status}}{% endraw %}' 2>/dev/null || echo "off")

    local vol_count img_count
    vol_count=$({{ securetty_podman_cmd }} volume ls --format '{% raw %}{{.Name}}{% endraw %}' 2>/dev/null | grep -c securetty || echo 0)
    img_count=$({{ securetty_podman_cmd }} images --format '{% raw %}{{.Repository}}{% endraw %}' 2>/dev/null | grep -c securetty || echo 0)

    local agent_count={{ securetty_agents | length }}
    local build_date
    build_date=$({{ securetty_podman_cmd }} image inspect securetty_dev --format '{% raw %}{{.Created}}{% endraw %}' 2>/dev/null | cut -dT -f1 || echo "unknown")

    local _gd_icon="✓" _osv_icon="✓"
    [ "$gd_status" != "running" ] && _gd_icon="✗"
    [ "$osv_status" != "running" ] && _osv_icon="✗"

    show_splash \
        "Containers|${running} running, ${healthy} healthy, ${total_containers} total" \
        "Agents|${agent_count} configured" \
        "Built|${build_date}" \
        "Images|${img_count}" \
        "---|" \
        "Network|${subnet}" \
        "Egress|${egress_ips} IPs whitelisted" \
        "DNS|${dns_status}" \
        "---|" \
        "GuardDog|${gd_status} ${_gd_icon}" \
        "OSV|${osv_status} ${_osv_icon}" \
        "Volumes|${vol_count} named"

    # Services table
    echo -e "  ${W}Services${N}"
    {{ securetty_podman_cmd }} ps -a --format "{% raw %}{{.Names}}\t{{.Status}}{% endraw %}" 2>/dev/null | grep securetty | while IFS=$'\t' read -r name status; do
        local icon="${G}●${N}"
        echo "$status" | grep -qi 'exited\|dead\|created' && icon="${R}●${N}"
        echo "$status" | grep -qi 'starting' && icon="${Y}●${N}"
        printf "  ${icon} %-28s %s\n" "$name" "$status"
    done
    echo ""
}

cmd_top() {
    local containers
    containers=$({{ securetty_podman_cmd }} ps --format '{% raw %}{{.Names}}{% endraw %}' 2>/dev/null | grep securetty | tr '\n' ' ')
    if [ -z "$containers" ]; then
        echo "No securetty containers running"
        return 1
    fi
    if [ "${1:-}" = "--live" ] || [ "${1:-}" = "-l" ]; then
        exec {{ securetty_podman_cmd }} stats $containers
    else
        {{ securetty_podman_cmd }} stats --no-stream $containers 2>/dev/null
        echo ""
        echo "Live view: securetty top --live"
    fi
}

cmd_logs() {
    local svc="${1:-}"
    local _valid_services
    _valid_services=$({{ securetty_podman_cmd }} ps -a --format '{% raw %}{{.Names}}{% endraw %}' 2>/dev/null | grep securetty | sed 's/^securetty-//' | sort)
    if [ -z "$svc" ]; then
        echo "Usage: securetty logs <service> [--follow]"
        echo "Services: $(echo "$_valid_services" | tr '\n' ' ')"
        return 1
    fi
    if ! echo "$_valid_services" | grep -qx "$svc"; then
        echo "ERROR: unknown service '${svc}'" >&2
        echo "Available: $(echo "$_valid_services" | tr '\n' ' ')" >&2
        return 1
    fi
    shift
    {{ securetty_podman_cmd }} logs "${@}" "securetty-${svc}"
}

cmd_restart() {
    echo "Restarting services..."
    (cd "$SECURETTY_DIR" && {{ securetty_compose_cmd }} down 2>/dev/null && {{ securetty_compose_cmd }} up -d --no-build)
    sleep 2
    _ensure_egress 2>/dev/null
    _patch_dns 2>/dev/null
    echo ""
    local _running
    _running=$({{ securetty_podman_cmd }} ps --format '{% raw %}{{.Names}}{% endraw %}' 2>/dev/null | grep -c securetty || echo 0)
    echo "${_running} services running."
}

cmd_exec() {
    local container="${1:-}"
    if [ -z "$container" ]; then
        echo "Usage: securetty exec <container> <command>"
        return 1
    fi
    local _state
    _state=$({{ securetty_podman_cmd }} inspect "securetty-${container}" --format '{% raw %}{{.State.Status}}{% endraw %}' 2>/dev/null || echo "missing")
    if [ "$_state" = "missing" ]; then
        echo "ERROR: container securetty-${container} not found" >&2
        return 1
    fi
    if [ "$_state" != "running" ]; then
        echo "ERROR: container securetty-${container} is ${_state}, not running" >&2
        return 1
    fi
    shift
    {{ securetty_podman_cmd }} exec -it "securetty-${container}" "$@"
}

_dispatcher_url() {
    local cert_args=""
    [ -f "$SECURETTY_DIR/certs/client.crt" ] && cert_args="--cert $SECURETTY_DIR/certs/client.crt --key $SECURETTY_DIR/certs/client.key --cacert $SECURETTY_DIR/certs/ca.crt"
    echo "$cert_args"
}

cmd_dispatch() {
    if [ $# -eq 0 ]; then
        echo "Usage: securetty dispatch <work-item> [--agent <name>] [--skill <name>]" >&2
        return 1
    fi
    local work_item="$1"; shift
    local agent="claude" skill=""
    while [ $# -gt 0 ]; do
        case "$1" in
            --agent) agent="$2"; shift 2 ;;
            --skill) skill="$2"; shift 2 ;;
            *) shift ;;
        esac
    done
    local cert_args
    cert_args=$(_dispatcher_url)
    local body="{\"work_item\":\"$work_item\",\"agent\":\"$agent\""
    [ -n "$skill" ] && body="$body,\"skill\":\"$skill\""
    body="$body}"
    curl $cert_args -sf -X POST "https://securetty-dispatcher:8900/dispatch" \
        -H "Content-Type: application/json" \
        -d "$body" 2>/dev/null | python3 -m json.tool 2>/dev/null || echo "ERROR: dispatcher unavailable" >&2
}

cmd_jobs() {
    local cert_args
    cert_args=$(_dispatcher_url)
    local filter=""
    [ -n "${1:-}" ] && filter="?status=$1"
    curl $cert_args -sf "https://securetty-dispatcher:8900/jobs${filter}" 2>/dev/null | python3 -m json.tool 2>/dev/null || echo "ERROR: dispatcher unavailable" >&2
}

cmd_watch() {
    local cert_args
    cert_args=$(_dispatcher_url)

    case "${1:-}" in
        --list|-l)
            curl $cert_args -sf "https://securetty-dispatcher:8900/triggers" 2>/dev/null | python3 -m json.tool 2>/dev/null || echo "ERROR: dispatcher unavailable" >&2
            ;;
        --delete|-d)
            local trigger_id="${2:-}"
            [ -z "$trigger_id" ] && { echo "Usage: securetty watch --delete <trigger-id>" >&2; return 1; }
            curl $cert_args -sf -X DELETE "https://securetty-dispatcher:8900/triggers/${trigger_id}" 2>/dev/null | python3 -m json.tool 2>/dev/null || echo "ERROR: dispatcher unavailable" >&2
            ;;
        --help|-h|"")
            echo "Usage: securetty watch <repo> [--source github|gitlab|jira] [--event <type>] [--interval <seconds>]" >&2
            echo "       securetty watch --list" >&2
            echo "       securetty watch --delete <trigger-id>" >&2
            return 1
            ;;
        *)
            local repo="$1"; shift
            local source="github" event="push" interval="300"
            while [ $# -gt 0 ]; do
                case "$1" in
                    --source) source="$2"; shift 2 ;;
                    --event) event="$2"; shift 2 ;;
                    --interval) interval="$2"; shift 2 ;;
                    *) shift ;;
                esac
            done
            curl $cert_args -sf -X POST "https://securetty-dispatcher:8900/triggers?source=$source&repo=$repo&event_type=$event&poll_interval=$interval" \
                -H "Content-Type: application/json" 2>/dev/null | python3 -m json.tool 2>/dev/null || echo "ERROR: dispatcher unavailable" >&2
            ;;
    esac
}

_run_script() { bash "$SECURETTY_DIR/roles/containers/files/$1" "${@:2}"; }

cmd_jira_triage() {
    case "${1:-}" in
        start|stop|status) _run_script securetty-jira-poller.sh "$@" ;;
        run) shift; _run_script securetty-jira-triage.sh "$@" ;;
        *) echo "Usage: securetty jira-triage start|stop|status|run <ISSUE-KEY>" >&2; return 1 ;;
    esac
}

cmd_version() {
    local _git_version
    _git_version=$(cd "$SECURETTY_DIR" && git describe --tags --always 2>/dev/null || echo "unknown")
    echo "securetty CLI"
    echo "  Version: ${_git_version}"
    echo "  Dir: $SECURETTY_DIR"
    echo "  Agents: {{ securetty_agents | length }} configured"
    local build_date
    build_date=$({{ securetty_podman_cmd }} image inspect securetty_dev --format '{% raw %}{{index .Labels "build_date"}}{% endraw %}' 2>/dev/null || echo "")
    [ -z "$build_date" ] && build_date=$({{ securetty_podman_cmd }} image inspect securetty_dev --format '{% raw %}{{.Created}}{% endraw %}' 2>/dev/null | cut -dT -f1 || echo "unknown")
    echo "  Image built: ${build_date:-unknown}"
    local img_count
    img_count=$({{ securetty_podman_cmd }} images --format '{% raw %}{{.Repository}}{% endraw %}' 2>/dev/null | grep -c securetty || echo 0)
    echo "  Images: $img_count"
}

