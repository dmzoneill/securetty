#!/bin/bash
# {{ ansible_managed }}
# securetty — sandboxed AI development environment CLI
set -euo pipefail

SECURETTY_DIR="$(cd "$(dirname "$0")" && pwd)"
SECURETTY_IMAGE="${SECURETTY_IMAGE:-securetty_dev}"

# Source session outcome logging helpers
# shellcheck source=roles/aliases/files/securetty-outcomes.sh
[ -f "$SECURETTY_DIR/roles/aliases/files/securetty-outcomes.sh" ] && \
    source "$SECURETTY_DIR/roles/aliases/files/securetty-outcomes.sh"

# =============================================================================
# Internal functions
# =============================================================================

_ensure_dirs() {
    mkdir -p {% for dir in securetty_agent_config_dirs %}~/{{ dir }} {% endfor %}2>/dev/null || true
}

_generate_env() {
    local env_file="$SECURETTY_DIR/.env"
    local max_age=300
    if [ -f "$env_file" ]; then
        local file_age=$(( $(date +%s) - $(stat -c %Y "$env_file") ))
        if [ "$file_age" -lt "$max_age" ]; then
            : # skip regeneration, .env is fresh (<5min)
        else
            bash "$SECURETTY_DIR/scripts/generate-env.sh" "$env_file" 2>/dev/null
        fi
    else
        bash "$SECURETTY_DIR/scripts/generate-env.sh" "$env_file" 2>/dev/null
    fi
    # Only extract non-secret vars needed for _run_personal/_run_work
    # Never source full .env into shell (leaks secrets to /proc/PID/environ)
    OMNIROUTE_API_KEY=$(grep -m1 '^OMNIROUTE_API_KEY=' "$env_file" 2>/dev/null | cut -d= -f2-)
    ANTHROPIC_VERTEX_PROJECT_ID=$(grep -m1 '^ANTHROPIC_VERTEX_PROJECT_ID=' "$env_file" 2>/dev/null | cut -d= -f2-)
    GOOGLE_CLOUD_PROJECT=$(grep -m1 '^GOOGLE_CLOUD_PROJECT=' "$env_file" 2>/dev/null | cut -d= -f2-)
    GOOGLE_CLOUD_LOCATION=$(grep -m1 '^GOOGLE_CLOUD_LOCATION=' "$env_file" 2>/dev/null | cut -d= -f2-)
    export OMNIROUTE_API_KEY ANTHROPIC_VERTEX_PROJECT_ID GOOGLE_CLOUD_PROJECT GOOGLE_CLOUD_LOCATION
}

_ensure_ssh_agent() {
    if [ ! -S "/run/user/$(id -u)/securetty-ssh-agent.sock" ]; then
        bash "$SECURETTY_DIR/scripts/ssh-agent-restricted.sh" start 2>/dev/null
    fi
}

_ensure_services() {
    if [ "$({{ securetty_podman_cmd }} inspect securetty-omniroute --format '{{ '{{' }}.State.Running{{ '}}' }}' 2>/dev/null)" != "true" ] || \
       [ "$({{ securetty_podman_cmd }} inspect securetty-headroom --format '{{ '{{' }}.State.Running{{ '}}' }}' 2>/dev/null)" != "true" ] || \
       [ "$({{ securetty_podman_cmd }} inspect securetty-creds --format '{{ '{{' }}.State.Running{{ '}}' }}' 2>/dev/null)" != "true" ]; then
        echo "Starting services..."
        (cd "$SECURETTY_DIR" && {{ securetty_compose_cmd }} up -d --no-build 2>/dev/null) || true
        sleep 1
    fi
}

_ensure_url_relay() {
    if [ ! -S "/run/user/$(id -u)/securetty-open.sock" ]; then
        bash "$SECURETTY_DIR/scripts/open-relay-host.sh" start &
        disown
        sleep 0.3
    fi
}

_ensure_egress() {
    local netns="/run/user/$(id -u)/containers/networks/rootless-netns/rootless-netns"
    [ -e "$netns" ] || return 0
    local has_table
    has_table=$({{ securetty_podman_cmd }} unshare nsenter --net="$netns" nft list tables 2>/dev/null | grep -c securetty_egress || true)
    if [ "$has_table" -eq 0 ]; then
        local egress_script="$SECURETTY_DIR/scripts/securetty-egress.sh"
        local resolve_script="$SECURETTY_DIR/scripts/resolve-egress.sh"
        if [ -x "$egress_script" ]; then
            {{ securetty_podman_cmd }} unshare nsenter --net="$netns" bash "$egress_script" 2>/dev/null
            [ -x "$resolve_script" ] && { bash "$resolve_script" &>/dev/null & disown; }
        fi
    else
        # Table exists but IPs may be stale — refresh in background
        local resolve_script="$SECURETTY_DIR/scripts/resolve-egress.sh"
        [ -x "$resolve_script" ] && { bash "$resolve_script" &>/dev/null & disown; }
    fi
}

_patch_dns() {
    local conf="/run/user/$(id -u)/containers/networks/aardvark-dns/{{ securetty_network_name }}"
    [ -f "$conf" ] || return 0
    if grep -q '8.8.8.8,8.8.4.4' "$conf" 2>/dev/null; then
        sed -i 's/8.8.8.8,8.8.4.4/169.254.1.1/g' "$conf"
        sed -i 's/169.254.1.1,169.254.1.1/169.254.1.1/g' "$conf"
        local pid
        pid=$(cat "/run/user/$(id -u)/containers/networks/aardvark-dns/aardvark.pid" 2>/dev/null)
        [ -n "$pid" ] && kill -HUP "$pid" 2>/dev/null
    fi
}

_preflight() {
    local errors=0 warnings=0
    echo "=== Securetty Preflight ==="

    # Hard checks (fail if missing)
    if ! {{ securetty_podman_cmd }} info &>/dev/null; then
        echo "  FAIL: podman not running"
        errors=$((errors + 1))
    else
        echo "  OK: podman"
    fi

    if ! {{ securetty_podman_cmd }} image exists securetty_dev 2>/dev/null; then
        echo "  FAIL: securetty_dev image not built (run securetty rebuild)"
        errors=$((errors + 1))
    else
        echo "  OK: dev image"
    fi

    if ! {{ securetty_podman_cmd }} network exists {{ securetty_network_name }} 2>/dev/null; then
        echo "  FAIL: securetty network not created (run securetty setup)"
        errors=$((errors + 1))
    else
        echo "  OK: network"
    fi

    # Service checks
    for svc in securetty-omniroute securetty-headroom securetty-creds; do
        if [ "$({{ securetty_podman_cmd }} inspect "$svc" --format '{% raw %}{{.State.Running}}{% endraw %}' 2>/dev/null)" = "true" ]; then
            echo "  OK: $svc"
        else
            echo "  WARN: $svc not running"
            warnings=$((warnings + 1))
        fi
    done

    # SSH agent
    if [ -S "/run/user/$(id -u)/securetty-ssh-agent.sock" ]; then
        echo "  OK: SSH agent"
        if [ -f "/run/user/$(id -u)/securetty-ssh-token" ]; then
            echo "  OK: SSH proxy token"
        else
            echo "  WARN: SSH proxy token missing"
            warnings=$((warnings + 1))
        fi
    else
        echo "  WARN: SSH agent not running"
        warnings=$((warnings + 1))
    fi

    # Env file
    if [ -f "$SECURETTY_DIR/.env" ]; then
        local key_count
        key_count=$(grep -c '=' "$SECURETTY_DIR/.env" 2>/dev/null || echo 0)
        echo "  OK: .env ($key_count keys)"
    else
        echo "  WARN: .env not generated (run securetty env)"
        warnings=$((warnings + 1))
    fi

    # Disk space
    local avail
    avail=$(df -BG --output=avail "$SECURETTY_DIR" 2>/dev/null | tail -1 | tr -d ' G')
    if [ "${avail:-0}" -lt 5 ]; then
        echo "  WARN: low disk space (${avail}G available)"
        warnings=$((warnings + 1))
    else
        echo "  OK: disk (${avail}G available)"
    fi

    echo ""
    echo "Results: $errors errors, $warnings warnings"
    [ "$errors" -eq 0 ] && return 0 || return 1
}

_extract_workdir() {
    _SECURETTY_WORKDIR="$(pwd)"
    _SECURETTY_ARGS=()
    for arg in "$@"; do
        if [ -d "$arg" ] && [ "$_SECURETTY_WORKDIR" = "$(pwd)" ]; then
            _SECURETTY_WORKDIR="$(realpath "$arg")"
        else
            _SECURETTY_ARGS+=("$arg")
        fi
    done
}

_convert_timeout_to_seconds() {
    local val="$1"
    local num="${val%[smhd]}"
    local unit="${val##*[0-9]}"
    case "$unit" in
        s|"") echo "$num" ;;
        m)    echo $((num * 60)) ;;
        h)    echo $((num * 3600)) ;;
        d)    echo $((num * 86400)) ;;
        *)    echo "$num" ;;
    esac
}

_parse_run_flags() {
    _SECURETTY_MAX_TURNS=""
    _SECURETTY_TIMEOUT=""
    _SECURETTY_FLAGPARSED_ARGS=()
    while [ $# -gt 0 ]; do
        case "$1" in
            --max-turns)
                _SECURETTY_MAX_TURNS="${2:-}"
                shift 2
                ;;
            --timeout)
                _SECURETTY_TIMEOUT="${2:-}"
                shift 2
                ;;
            *)
                _SECURETTY_FLAGPARSED_ARGS+=("$1")
                shift
                ;;
        esac
    done
}

_build_envfile() {
    local envfile
    envfile=$(umask 077; mktemp /run/user/$(id -u)/securetty-env.XXXXXX) || { echo "ERROR: mktemp failed" >&2; return 1; }
    [ -n "$envfile" ] || { echo "ERROR: empty envfile path" >&2; return 1; }

    # Zero-secret agent env — only OMNIROUTE_API_KEY + non-secret config
    grep -E '^OMNIROUTE_API_KEY=' "$SECURETTY_DIR/.env" >> "$envfile" 2>/dev/null || true
    grep -E '^(CLAUDE_CODE_USE_VERTEX|ANTHROPIC_VERTEX_PROJECT_ID|GOOGLE_CLOUD_PROJECT|GOOGLE_CLOUD_LOCATION|CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC)=' "$SECURETTY_DIR/.env" >> "$envfile" 2>/dev/null || true

    cat >> "$envfile" <<ENVEOF
HOME={{ securetty_home }}
USER={{ securetty_user }}
SSH_AUTH_SOCK=/run/ssh-agent.sock
GPG_AGENT_INFO=/run/gpg-agent.sock
XDG_RUNTIME_DIR=/run/user/$(id -u)
NODE_ENV=development
npm_config_ignore_scripts=true
NODE_EXTRA_CA_CERTS=/certs/ca.crt
npm_config_cache={{ securetty_home }}/.npm
npm_config_prefix={{ securetty_home }}/.npm-global
CARGO_HOME={{ securetty_home }}/.cargo
GOPATH={{ securetty_home }}/go
GOBIN={{ securetty_home }}/go/bin
PYTHONUSERBASE={{ securetty_home }}/.local
PIP_USER=1
PATH={{ securetty_home }}/.npm-global/bin:{{ securetty_home }}/go/bin:{{ securetty_home }}/.cargo/bin:{{ securetty_home }}/.local/bin:/usr/local/bin:/usr/bin:/bin
OMNIROUTE_BASE_URL=http://securetty-omniroute:4000
HEADROOM_URL=http://securetty-headroom:8787
OLLAMA_HOST=http://securetty-ollama:11434
CLOUDCLI_URL=http://securetty-cloudcli:3001
ENVEOF

    [ -n "${_SECURETTY_MAX_TURNS:-}" ] && echo "SECURETTY_MAX_TURNS=${_SECURETTY_MAX_TURNS}" >> "$envfile"
    [ -n "${_SECURETTY_TIMEOUT:-}" ] && echo "SECURETTY_TIMEOUT=${_SECURETTY_TIMEOUT}" >> "$envfile"

    if [ -n "${_SECURETTY_EXTRA_ENVLINES+x}" ]; then
        printf '%s\n' "${_SECURETTY_EXTRA_ENVLINES[@]}" >> "$envfile"
    fi

    echo "$envfile"
}

_run() {
    local agent="$1"
    shift

    _ensure_dirs
    _generate_env
    _ensure_ssh_agent
    _ensure_services
    _ensure_url_relay

    local envfile
    envfile=$(_build_envfile) || return 1
    trap "rm -f '$envfile'" EXIT

    _SSH_TOKEN_MOUNT=""
    [ -f "/run/user/$(id -u)/securetty-ssh-token" ] && _SSH_TOKEN_MOUNT="-v /run/user/$(id -u)/securetty-ssh-token:/run/ssh-token:ro"

    _ensure_egress 2>/dev/null
    _patch_dns 2>/dev/null
    { sleep 2 && _patch_dns; } &>/dev/null & disown

    local _run_start_ts
    _run_start_ts=$(date +%s)

    # Build the podman command
    local _podman_cmd=(
        {{ securetty_podman_cmd }} run --rm -it
        --env-file "$envfile"
        --network {{ securetty_network_name }}
        --name "securetty-${agent}-$$"
        --hostname "securetty-${agent}"
        --user "$(id -u):$(id -g)"
        --userns=keep-id
        --cap-drop ALL
        --security-opt no-new-privileges:true
        --security-opt label=disable
        --security-opt "mask=/proc/mounts:/proc/self/mounts:/proc/self/mountinfo:/proc/cmdline:/proc/partitions:/proc/diskstats:/proc/version:/sys/class/dmi"
        --read-only
        --pids-limit 4096
        -v "{{ securetty_home }}/src:{{ securetty_home }}/src"
        -v "{{ securetty_home }}/.gitconfig:{{ securetty_home }}/.gitconfig:ro"
        -v "{{ securetty_home }}/.gnupg/pubring.kbx:{{ securetty_home }}/.gnupg/pubring.kbx:ro"
        -v "{{ securetty_home }}/.gnupg/trustdb.gpg:{{ securetty_home }}/.gnupg/trustdb.gpg:ro"
        -v "/run/user/$(id -u)/securetty-ssh-agent.sock:/run/ssh-agent.sock:ro"
        ${_SSH_TOKEN_MOUNT:-}
        -v "{{ securetty_home }}/.ssh/config:{{ securetty_home }}/.ssh/config:ro"
        -v "{{ securetty_home }}/.ssh/known_hosts:{{ securetty_home }}/.ssh/known_hosts:ro"
        -v "{{ securetty_home }}/.claude.json:{{ securetty_home }}/.claude.json"
{% for dir in securetty_agent_config_dirs %}
        -v "{{ securetty_home }}/{{ dir }}:{{ securetty_home }}/{{ dir }}"
{% endfor %}
        -v "{{ securetty_home }}/bin:{{ securetty_home }}/bin:ro"
        -v "{{ securetty_home }}/.kube:{{ securetty_home }}/.kube"
        -v "{{ securetty_home }}/.aws:{{ securetty_home }}/.aws:ro"
        -v "{{ securetty_home }}/Downloads:{{ securetty_home }}/Downloads"
        -v "{{ securetty_home }}/.local/bin:{{ securetty_home }}/.local/bin:ro"
        -v "{{ securetty_home }}/.local/share/virtualenvs:{{ securetty_home }}/.local/share/virtualenvs"
        -v "/run/user/$(id -u)/pipewire-0:/run/user/$(id -u)/pipewire-0"
        -v "/run/user/$(id -u)/pulse:/run/user/$(id -u)/pulse"
        -v "${GPG_AGENT_EXTRA_SOCK:-/dev/null}:/run/gpg-agent.sock:ro"
        -v "/run/user/$(id -u)/securetty-open.sock:/run/securetty-open.sock"
        -v "$SECURETTY_DIR/certs:/certs:ro"
        --tmpfs /tmp:size=512M
        -v securetty-npm-cache:{{ securetty_home }}/.npm
        -v securetty-pip-cache:{{ securetty_home }}/.cache/pip
        -v securetty-uv-cache:{{ securetty_home }}/.cache/uv
        -v securetty-cargo-cache:{{ securetty_home }}/.cargo
        -v securetty-go-cache:{{ securetty_home }}/go
        -v securetty-pip-user:{{ securetty_home }}/.local/lib
        -v securetty-npm-global:{{ securetty_home }}/.npm-global
        -v securetty-usr-local:/usr/local
        --tmpfs {{ securetty_home }}/.cache/mesa_shader_cache:size=128M
        -w "${_SECURETTY_WORKDIR:-$(pwd)}"
        "$SECURETTY_IMAGE"
        "$agent" "$@"
    )

    # Execute with optional timeout enforcement
    local _run_exit_code=0
    if [ -n "${_SECURETTY_TIMEOUT:-}" ]; then
        local _timeout_seconds
        _timeout_seconds=$(_convert_timeout_to_seconds "$_SECURETTY_TIMEOUT")
        timeout --signal=TERM --kill-after=30 "$_timeout_seconds" "${_podman_cmd[@]}" || _run_exit_code=$?
    else
        "${_podman_cmd[@]}" || _run_exit_code=$?
    fi

    rm -f "$envfile"

    # Calculate session duration and log outcome
    local _run_end_ts _run_duration
    _run_end_ts=$(date +%s)
    _run_duration=$(( _run_end_ts - _run_start_ts ))

    if type -t _log_session_outcome &>/dev/null; then
        _log_session_outcome "$agent" "$_run_exit_code" "$_run_duration" "${_SECURETTY_WORKDIR:-$(pwd)}"
    fi

    # Log session cost (Claude Code writes cost to ~/.claude/projects/*/usage.json)
    local cost_dir="{{ securetty_home }}/.securetty/cost"
    mkdir -p "$cost_dir" 2>/dev/null || true
    local cost_log="$cost_dir/$(date +%Y-%m-%d).jsonl"
    local session_end
    session_end=$(date -u +%FT%TZ)
    echo "{\"agent\":\"$agent\",\"end\":\"$session_end\",\"mode\":\"${_SECURETTY_MODE:-personal}\",\"exit_code\":${_run_exit_code},\"duration\":${_run_duration}}" >> "$cost_log" 2>/dev/null || true

    return $_run_exit_code
}

# =============================================================================
# Mode wrappers
# =============================================================================

_run_work() {
    local agent="$1"
    shift
    if [ "${1:-}" = "--read" ]; then
        shift
        _SECURETTY_READ_MODE=1
    fi
    _SECURETTY_EXTRA_ENVLINES=(
        "CLAUDE_CODE_USE_VERTEX=1"
{% raw %}
        "ANTHROPIC_VERTEX_PROJECT_ID=${ANTHROPIC_VERTEX_PROJECT_ID:-}"
        "GOOGLE_CLOUD_PROJECT=${GOOGLE_CLOUD_PROJECT:-}"
        "GOOGLE_CLOUD_LOCATION=${GOOGLE_CLOUD_LOCATION:-}"
{% endraw %}
        "CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC=1"
        "ANTHROPIC_BASE_URL="
        "GOOGLE_APPLICATION_CREDENTIALS={{ securetty_home }}/.config/gcloud/application_default_credentials.json"
    )
    [ "${_SECURETTY_READ_MODE:-}" = "1" ] && _SECURETTY_EXTRA_ENVLINES+=("SECURETTY_MODE=read")
    _SECURETTY_MODE="work"
    _run "$agent" "$@"
}

_run_personal() {
    local agent="$1"
    shift
    if [ "${1:-}" = "--read" ]; then
        shift
        _SECURETTY_READ_MODE=1
    fi
{% raw %}
    local omni_key="${OMNIROUTE_API_KEY:-}"
{% endraw %}
    _SECURETTY_EXTRA_ENVLINES=(
{% raw %}
        "CLAUDE_CODE_USE_VERTEX="
        "ANTHROPIC_BASE_URL=http://securetty-omniroute:4000"
        "ANTHROPIC_API_KEY=${omni_key}"
        "OPENAI_BASE_URL=http://securetty-omniroute:4000/v1"
        "OPENAI_API_KEY=${omni_key}"
        "GEMINI_API_KEY="
        "GOOGLE_API_KEY=${omni_key}"
        "OPENAI_API_BASE=http://securetty-omniroute:4000/v1"
{% endraw %}
    )
    [ "${_SECURETTY_READ_MODE:-}" = "1" ] && _SECURETTY_EXTRA_ENVLINES+=("SECURETTY_MODE=read")
    _SECURETTY_MODE="personal"
    _run "$agent" "$@"
}

# =============================================================================
# Subcommands
# =============================================================================

cmd_run() {
    if [ $# -eq 0 ]; then
        echo "Usage: securetty run <agent> [--max-turns N] [--timeout T] [workdir]" >&2
        echo "Available agents: {{ securetty_agents | map(attribute='name') | join(', ') }}" >&2
        return 1
    fi
    _parse_run_flags "$@"
    _extract_workdir "${_SECURETTY_FLAGPARSED_ARGS[@]}"
    _run_personal "${_SECURETTY_ARGS[@]}"
}

cmd_run_work() {
    if [ $# -eq 0 ]; then
        echo "Usage: securetty run-work <agent> [--max-turns N] [--timeout T] [workdir]" >&2
        return 1
    fi
    _parse_run_flags "$@"
    _extract_workdir "${_SECURETTY_FLAGPARSED_ARGS[@]}"
    _run_work "${_SECURETTY_ARGS[@]}"
}

cmd_shell() {
    _extract_workdir "$@"
    _run_personal /bin/bash
}

cmd_setup() {
    (cd "$SECURETTY_DIR" && ansible-playbook site.yml "$@")
}

cmd_rebuild() {
    (cd "$SECURETTY_DIR" && ansible-playbook site.yml --tags prereqs,build -e securetty_force_rebuild=true "$@")
}

cmd_rebuild_agents() {
    (cd "$SECURETTY_DIR" && ansible-playbook site.yml --tags prereqs,build -e securetty_force_rebuild=true -e securetty_skip_devbase=true -e securetty_dev_only=true "$@")
}

cmd_up() {
    (cd "$SECURETTY_DIR" && ansible-playbook site.yml --tags prereqs,up "$@")
}

cmd_down() {
    (cd "$SECURETTY_DIR" && {{ securetty_compose_cmd }} down)
}

cmd_egress() {
    (cd "$SECURETTY_DIR" && ansible-playbook site.yml --tags prereqs,egress "$@")
}

cmd_env() {
    (cd "$SECURETTY_DIR" && ansible-playbook site.yml --tags prereqs,env "$@")
}

cmd_scan() {
    local mode="${1:-summary}"
    case "$mode" in
        alerts)
            echo "=== GuardDog Alerts ==="
            {{ securetty_podman_cmd }} exec securetty-guarddog cat /results/alerts.log 2>/dev/null || echo "No alerts"
            echo ""
            echo "=== OSV-Scanner Alerts ==="
            {{ securetty_podman_cmd }} exec securetty-osv-scanner cat /results/alerts.log 2>/dev/null || echo "No alerts"
            ;;
        logs)
            echo "=== GuardDog Log ==="
            {{ securetty_podman_cmd }} logs --tail 50 securetty-guarddog 2>/dev/null || echo "Not running"
            echo ""
            echo "=== OSV-Scanner Log ==="
            {{ securetty_podman_cmd }} logs --tail 50 securetty-osv-scanner 2>/dev/null || echo "Not running"
            ;;
        *)
            echo "=== Scanner Status ==="
            {{ securetty_podman_cmd }} ps --format "{% raw %}{{.Names}}\t{{.Status}}{% endraw %}" --filter name=guarddog --filter name=osv 2>/dev/null || echo "Not running"
            echo ""
            echo "=== Recent Activity ==="
            {{ securetty_podman_cmd }} logs --tail 5 securetty-guarddog 2>/dev/null || true
            {{ securetty_podman_cmd }} logs --tail 5 securetty-osv-scanner 2>/dev/null || true
            echo ""
            local gd_alerts osv_alerts
            gd_alerts=$({{ securetty_podman_cmd }} exec securetty-guarddog wc -l /results/alerts.log 2>/dev/null | awk '{print $1}' || echo "0")
            osv_alerts=$({{ securetty_podman_cmd }} exec securetty-osv-scanner wc -l /results/alerts.log 2>/dev/null | awk '{print $1}' || echo "0")
            echo "GuardDog alerts: ${gd_alerts:-0}"
            echo "OSV-Scanner alerts: ${osv_alerts:-0}"
            [ "${gd_alerts:-0}" != "0" ] || [ "${osv_alerts:-0}" != "0" ] && echo "Run 'securetty scan alerts' for details"
            ;;
    esac
}

cmd_volumes() {
    echo "=== Package Volumes ==="
    for vol in securetty-usr-local securetty-npm-cache securetty-npm-global securetty-pip-cache securetty-pip-user securetty-uv-cache securetty-cargo-cache securetty-go-cache; do
        local size
        size=$({{ securetty_podman_cmd }} volume inspect "$vol" --format '{% raw %}{{.Mountpoint}}{% endraw %}' 2>/dev/null)
        if [ -n "$size" ]; then
            local du_size
            du_size=$(du -sh "$size" 2>/dev/null | awk '{print $1}' || echo "?")
            printf "  %-25s %s\n" "$vol" "$du_size"
        else
            printf "  %-25s %s\n" "$vol" "(not created)"
        fi
    done
    echo ""
    echo "=== Scanner Volumes ==="
    for vol in guarddog_results osv_results; do
        local size
        size=$({{ securetty_podman_cmd }} volume inspect "$vol" --format '{% raw %}{{.Mountpoint}}{% endraw %}' 2>/dev/null)
        if [ -n "$size" ]; then
            local du_size
            du_size=$(du -sh "$size" 2>/dev/null | awk '{print $1}' || echo "?")
            printf "  %-25s %s\n" "$vol" "$du_size"
        else
            printf "  %-25s %s\n" "$vol" "(not created)"
        fi
    done
    echo ""
    echo "=== Service Volumes ==="
    for vol in headroom_data cloudcli_data ollama_models; do
        local size
        size=$({{ securetty_podman_cmd }} volume inspect "$vol" --format '{% raw %}{{.Mountpoint}}{% endraw %}' 2>/dev/null)
        if [ -n "$size" ]; then
            local du_size
            du_size=$(du -sh "$size" 2>/dev/null | awk '{print $1}' || echo "?")
            printf "  %-25s %s\n" "$vol" "$du_size"
        else
            printf "  %-25s %s\n" "$vol" "(not created)"
        fi
    done
}

cmd_clean() {
    echo "=== Orphaned containers ==="
    local orphans
    orphans=$({{ securetty_podman_cmd }} ps -a --format '{% raw %}{{.Names}}{% endraw %}' --filter status=exited | grep securetty || true)
    if [ -n "$orphans" ]; then
        echo "$orphans"
        echo "Removing..."
        echo "$orphans" | xargs {{ securetty_podman_cmd }} rm -f 2>/dev/null || true
    else
        echo "None"
    fi
    echo ""
    echo "=== Dangling images ==="
    {{ securetty_podman_cmd }} image prune -f 2>/dev/null | tail -1 || echo "None"
    echo ""
    echo "=== Stale env files ==="
    local stale
    stale=$(find /run/user/$(id -u)/ -name 'securetty-env.*' -mmin +60 2>/dev/null || true)
    if [ -n "$stale" ]; then
        echo "$stale"
        echo "Removing..."
        echo "$stale" | xargs rm -f 2>/dev/null || true
    else
        echo "None"
    fi
    echo ""
    echo "=== Orphaned volumes ==="
    local orphan_vols
    orphan_vols=$({{ securetty_podman_cmd }} volume ls --format '{% raw %}{{.Name}}{% endraw %}' 2>/dev/null | grep securetty | while read -r vol; do
        {{ securetty_podman_cmd }} volume inspect "$vol" --format '{% raw %}{{.Containers}}{% endraw %}' 2>/dev/null | grep -q '^\[\]$' && echo "$vol"
    done || true)
    if [ -n "$orphan_vols" ]; then
        echo "$orphan_vols"
        echo "Removing..."
        echo "$orphan_vols" | xargs {{ securetty_podman_cmd }} volume rm 2>/dev/null || true
    else
        echo "None"
    fi
}

cmd_cost() {
    command -v jq &>/dev/null || { echo "jq required for cost reports. Install: dnf install jq"; return 1; }
    local cost_dir="{{ securetty_home }}/.securetty/cost"
    local period="${1:-today}"

    if [ ! -d "$cost_dir" ]; then
        echo "No cost data yet. Run an agent session first."
        return 0
    fi

    case "$period" in
        today)
            local file="$cost_dir/$(date +%Y-%m-%d).jsonl"
            if [ -f "$file" ]; then
                local count
                count=$(wc -l < "$file")
                echo "=== Today ($(date +%Y-%m-%d)) ==="
                echo "Sessions: $count"
                echo ""
                echo "By agent:"
                jq -r '.agent' "$file" 2>/dev/null | sort | uniq -c | sort -rn
                echo ""
                echo "By mode:"
                jq -r '.mode' "$file" 2>/dev/null | sort | uniq -c | sort -rn
            else
                echo "No sessions today."
            fi
            ;;
        week)
            echo "=== Last 7 days ==="
            local total=0
            for i in $(seq 0 6); do
                local d
                d=$(date -d "$i days ago" +%Y-%m-%d)
                local file="$cost_dir/${d}.jsonl"
                if [ -f "$file" ]; then
                    local c
                    c=$(wc -l < "$file")
                    total=$((total + c))
                    printf "  %s: %d sessions\n" "$d" "$c"
                fi
            done
            echo ""
            echo "Total: $total sessions"
            ;;
        all)
            echo "=== All time ==="
            local total=0
            for file in "$cost_dir"/*.jsonl; do
                [ -f "$file" ] || continue
                local d c
                d=$(basename "$file" .jsonl)
                c=$(wc -l < "$file")
                total=$((total + c))
                printf "  %s: %d sessions\n" "$d" "$c"
            done
            echo ""
            echo "Total: $total sessions"
            ;;
        *)
            echo "Usage: securetty cost [today|week|all]"
            ;;
    esac
}

cmd_preflight() {
    _preflight
