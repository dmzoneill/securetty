#!/bin/bash
# Auto-generated by ansible — securetty shell aliases.
# Each AI agent command creates a NEW ephemeral container from securetty image.

SECURETTY_IMAGE="${SECURETTY_IMAGE:-securetty_dev}"
SECURETTY_DIR="${SECURETTY_DIR:-{{ securetty_dir }}}"

_securetty_run() {
    local agent="$1"
    shift

    # Ensure all agent config dirs exist on host
    mkdir -p {% for dir in securetty_agent_config_dirs %}~/{{ dir }} {% endfor %}2>/dev/null

    # Generate fresh .env from host environment + config files
    bash "$SECURETTY_DIR/scripts/generate-env.sh" "$SECURETTY_DIR/.env" 2>/dev/null

    # Source generated .env so podman run picks up the values
    set -a
    source "$SECURETTY_DIR/.env" 2>/dev/null || true
    set +a

    # Start restricted SSH agent if not running
    if [ ! -S "/run/user/$(id -u)/securetty-ssh-agent.sock" ]; then
        bash "$SECURETTY_DIR/scripts/ssh-agent-restricted.sh" start 2>/dev/null
    fi

    # Ensure services are running (start only, no build)
    if [ "$({{ securetty_podman_cmd }} inspect securetty-omniroute --format '{{ '{{' }}.State.Running{{ '}}' }}' 2>/dev/null)" != "true" ] || \
       [ "$({{ securetty_podman_cmd }} inspect securetty-headroom --format '{{ '{{' }}.State.Running{{ '}}' }}' 2>/dev/null)" != "true" ]; then
        echo "Starting services..."
        (cd "$SECURETTY_DIR" && {{ securetty_compose_cmd }} up -d --no-build 2>/dev/null) || true
        sleep 1
    fi

    # Start URL relay if not running
    if [ ! -S "/run/user/$(id -u)/securetty-open.sock" ]; then
        bash "$SECURETTY_DIR/scripts/open-relay-host.sh" start &
        disown
        sleep 0.3
    fi

    {{ securetty_podman_cmd }} run --rm -it \
        ${_SECURETTY_EXTRA_ENV[@]+"${_SECURETTY_EXTRA_ENV[@]}"} \
        --name "securetty-${agent}-$$" \
        --hostname "securetty-${agent}" \
        --user "$(id -u):$(id -g)" \
        --cap-drop ALL \
        --cap-add SYS_NICE \
        --security-opt no-new-privileges:true \
        --security-opt label=disable \
        --read-only \
        --device /dev/dri \
        \
        -v "{{ securetty_home }}/src:{{ securetty_home }}/src" \
        -v "{{ securetty_home }}/.gitconfig:{{ securetty_home }}/.gitconfig:ro" \
        -v "{{ securetty_home }}/.gnupg/pubring.kbx:{{ securetty_home }}/.gnupg/pubring.kbx:ro" \
        -v "{{ securetty_home }}/.gnupg/trustdb.gpg:{{ securetty_home }}/.gnupg/trustdb.gpg:ro" \
        -v "/run/user/$(id -u)/securetty-ssh-agent.sock:/run/ssh-agent.sock:ro" \
        -v "{{ securetty_home }}/.ssh/config:{{ securetty_home }}/.ssh/config:ro" \
        -v "{{ securetty_home }}/.ssh/known_hosts:{{ securetty_home }}/.ssh/known_hosts:ro" \
        -v "{{ securetty_home }}/.claude.json:{{ securetty_home }}/.claude.json" \
{% for dir in securetty_agent_config_dirs %}
        -v "{{ securetty_home }}/{{ dir }}:{{ securetty_home }}/{{ dir }}" \
{% endfor %}
        -v "{{ securetty_home }}/bin:{{ securetty_home }}/bin:ro" \
        -v "{{ securetty_home }}/.kube:{{ securetty_home }}/.kube" \
        -v "{{ securetty_home }}/.aws:{{ securetty_home }}/.aws:ro" \
        -v "{{ securetty_home }}/.local/bin:{{ securetty_home }}/.local/bin:ro" \
        -v "{{ securetty_home }}/.local/share/virtualenvs:{{ securetty_home }}/.local/share/virtualenvs" \
        -v "/run/user/$(id -u):/run/user/$(id -u)" \
        \
        -v "${GPG_AGENT_EXTRA_SOCK:-/dev/null}:/run/gpg-agent.sock:ro" \
        -v "/run/user/$(id -u)/securetty-open.sock:/run/securetty-open.sock" \
        \
        --tmpfs /tmp:size=512M \
        --tmpfs {{ securetty_home }}/.npm:size=256M \
        --tmpfs {{ securetty_home }}/.cache:size=1G \
        \
        -w "${_SECURETTY_WORKDIR:-$(pwd)}" \
        -e HOME={{ securetty_home }} \
        -e USER={{ securetty_user }} \
        -e SSH_AUTH_SOCK=/run/ssh-agent.sock \
        -e GPG_AGENT_INFO=/run/gpg-agent.sock \
        -e XDG_RUNTIME_DIR=/run/user/$(id -u) \
        -e NODE_ENV=development \
        -e npm_config_ignore_scripts=true \
{% for key in securetty_pass_keys %}
        -e "{{ key.var }}={% raw %}${{% endraw %}{{ key.var }}{% raw %}:-}{% endraw %}" \
{% endfor %}
{% for alias in securetty_key_aliases %}
        -e "{{ alias.var }}={% raw %}${{% endraw %}{{ alias.source }}{% raw %}:-}{% endraw %}" \
{% endfor %}
        -e "OMNIROUTE_BASE_URL=http://securetty-omniroute:4000" \
        -e "HEADROOM_URL=http://securetty-headroom:8787" \
        -e "OLLAMA_HOST=http://securetty-ollama:11434" \
        -e "CLOUDCLI_URL=http://securetty-cloudcli:3001" \
        \
        --network securetty_internal \
        \
        "$SECURETTY_IMAGE" \
        "$agent" "$@"
}

# Work mode: Vertex for Claude/Gemini
_securetty_run_work() {
    local agent="$1"
    shift
    _SECURETTY_EXTRA_ENV=(
        -e "CLAUDE_CODE_USE_VERTEX=1"
        -e "ANTHROPIC_VERTEX_PROJECT_ID=${ANTHROPIC_VERTEX_PROJECT_ID:-}"
        -e "GOOGLE_CLOUD_PROJECT=${GOOGLE_CLOUD_PROJECT:-}"
        -e "GOOGLE_CLOUD_LOCATION=${GOOGLE_CLOUD_LOCATION:-}"
        -e "CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC=1"
        -e "ANTHROPIC_BASE_URL="
        -e "GOOGLE_APPLICATION_CREDENTIALS={{ securetty_home }}/.config/gcloud/application_default_credentials.json"
    )
    _securetty_run "$agent" "$@"
}

# Personal mode: route through omniroute
_securetty_run_personal() {
    local agent="$1"
    shift
    local omni_key="${OMNIROUTE_API_KEY:-}"
    _SECURETTY_EXTRA_ENV=(
        -e "CLAUDE_CODE_USE_VERTEX="
        -e "ANTHROPIC_BASE_URL=http://securetty-omniroute:4000"
        -e "ANTHROPIC_API_KEY=${omni_key}"
        -e "OPENAI_BASE_URL=http://securetty-omniroute:4000/v1"
        -e "OPENAI_API_KEY=${omni_key}"
        -e "GEMINI_API_KEY="
        -e "GOOGLE_API_KEY=${omni_key}"
        -e "OPENAI_API_BASE=http://securetty-omniroute:4000/v1"
    )
    _securetty_run "$agent" "$@"
}

# Extract dir arg from any position
_extract_workdir() {
    _SECURETTY_WORKDIR="$(pwd)"
    local args=()
    for arg in "$@"; do
        if [ -d "$arg" ] && [ "$_SECURETTY_WORKDIR" = "$(pwd)" ]; then
            _SECURETTY_WORKDIR="$(realpath "$arg")"
        else
            args+=("$arg")
        fi
    done
    _SECURETTY_ARGS=("${args[@]}")
}

# =================================================================
# Agent aliases — generated from securetty_agents variable
# =================================================================
{% for agent in securetty_agents %}

{% if agent.skip %}
{{ agent.name }}()      { _extract_workdir "$@"; _securetty_run_personal {{ agent.name }} {{ agent.skip }} "${_SECURETTY_ARGS[@]}"; }
{% if agent.work | default(false) %}
{{ agent.name }}-work() { _extract_workdir "$@"; _securetty_run_work {{ agent.name }} {{ agent.skip }} "${_SECURETTY_ARGS[@]}"; }
{% endif %}
{% else %}
{{ agent.name }}()      { _extract_workdir "$@"; _securetty_run_personal {{ agent.name }} "${_SECURETTY_ARGS[@]}"; }
{% if agent.work | default(false) %}
{{ agent.name }}-work() { _extract_workdir "$@"; _securetty_run_work {{ agent.name }} "${_SECURETTY_ARGS[@]}"; }
{% endif %}
{% endif %}
{% if agent.short %}
alias {{ agent.short }}='{{ agent.name }}'
{% if agent.work | default(false) %}
alias {{ agent.short }}w='{{ agent.name }}-work'
{% endif %}
{% endif %}
{% endfor %}

# Services
headroom() { _securetty_run headroom "$@"; }
alias c-h='headroom proxy --port 8787'
omniroute(){ _securetty_run omniroute "$@"; }

# Shell
securetty-shell() { _securetty_run /bin/bash; }
alias ss='securetty-shell'
