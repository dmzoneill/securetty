#!/bin/bash
# {{ ansible_managed }}
# Agent aliases — thin shims delegating to securetty CLI.

{% for agent in securetty_agents %}
{% if agent.skip %}
{{ agent.name }}()      { {{ securetty_dir }}/securetty run {{ agent.name }} {{ agent.skip }} "$@"; }
{% if agent.work | default(false) %}
{{ agent.name }}-work() { {{ securetty_dir }}/securetty run-work {{ agent.name }} {{ agent.skip }} "$@"; }
{% endif %}
{% else %}
{{ agent.name }}()      { {{ securetty_dir }}/securetty run {{ agent.name }} "$@"; }
{% if agent.work | default(false) %}
{{ agent.name }}-work() { {{ securetty_dir }}/securetty run-work {{ agent.name }} "$@"; }
{% endif %}
{% endif %}
{% if agent.short %}
alias {{ agent.short }}='{{ agent.name }}'
{% if agent.work | default(false) %}
alias {{ agent.short }}w='{{ agent.name }}-work'
{% endif %}
{% endif %}
{% endfor %}

alias ss='{{ securetty_dir }}/securetty shell'
