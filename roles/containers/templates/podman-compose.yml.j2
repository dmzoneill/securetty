version: "3.8"

services:
  dev:
    build:
      context: .
      dockerfile: Containerfile
    container_name: securetty
    hostname: securetty

    # Non-root, minimal capabilities for Wayland/devkit
    user: "{{ securetty_uid }}:{{ securetty_gid }}"
    userns_mode: keep-id
    cap_drop:
      - ALL
    security_opt:
      - no-new-privileges:true
      - label=disable
      - "mask=/proc/mounts:/proc/self/mounts:/proc/self/mountinfo:/proc/cmdline:/proc/partitions:/proc/diskstats:/proc/version:/sys/class/dmi"

    # Read-only root filesystem — explicit writable mounts below
    read_only: true

    volumes:
      # =================================================================
      # Source repos — same path as host, rw
      # =================================================================
      - {{ securetty_home }}/src:{{ securetty_home }}/src

      # Host tool symlinks (~/bin → ~/src/*/scripts)
      - {{ securetty_home }}/bin:{{ securetty_home }}/bin:ro

      # Kubernetes/OpenShift config
      - {{ securetty_home }}/.kube:{{ securetty_home }}/.kube

      # AWS config
      - {{ securetty_home }}/.aws:{{ securetty_home }}/.aws:ro

      # Claude config
      - {{ securetty_home }}/.claude.json:{{ securetty_home }}/.claude.json

      # Downloads
      - {{ securetty_home }}/Downloads:{{ securetty_home }}/Downloads

      # XDG_RUNTIME_DIR — audio (PipeWire/PulseAudio), D-Bus, etc.
      - /run/user/{{ securetty_uid }}:/run/user/{{ securetty_uid }}

      # Pipenv virtualenvs
      - {{ securetty_home }}/.local/share/virtualenvs:{{ securetty_home }}/.local/share/virtualenvs

      # AI agent config dirs — full mount for persistence
{% for dir in securetty_agent_config_dirs %}
      - {{ securetty_home }}/{{ dir }}:{{ securetty_home }}/{{ dir }}
{% endfor %}

      # --- xdg-open relay socket (URLs sent to host browser) ---
      - /run/user/{{ securetty_uid }}/securetty-open.sock:/run/securetty-open.sock

      # --- SSH: restricted agent ({{ securetty_ssh_key }}, no private key in container) ---
      - /run/user/{{ securetty_uid }}/securetty-ssh-agent.sock:/run/ssh-agent.sock:ro
      - {{ securetty_home }}/.ssh/config:{{ securetty_home }}/.ssh/config:ro
      - {{ securetty_home }}/.ssh/known_hosts:{{ securetty_home }}/.ssh/known_hosts:ro

      # --- GPG agent forwarding (extra-socket, no key export) ---
      - ${GPG_AGENT_EXTRA_SOCK:-/dev/null}:/run/gpg-agent.sock:ro
      - {{ securetty_home }}/.gnupg/pubring.kbx:{{ securetty_home }}/.gnupg/pubring.kbx:ro
      - {{ securetty_home }}/.gnupg/trustdb.gpg:{{ securetty_home }}/.gnupg/trustdb.gpg:ro
      - {{ securetty_home }}/.gitconfig:{{ securetty_home }}/.gitconfig:ro

      # TLS certificates for credential proxy mTLS
      - {{ securetty_dir }}/certs:/certs:ro

      # Shared package caches (persist across containers)
      - securetty-npm-cache:{{ securetty_home }}/.npm
      - securetty-pip-cache:{{ securetty_home }}/.cache/pip
      - securetty-uv-cache:{{ securetty_home }}/.cache/uv
      - securetty-cargo-cache:{{ securetty_home }}/.cargo
      - securetty-go-cache:{{ securetty_home }}/go
      - securetty-pip-user:{{ securetty_home }}/.local/lib
      - securetty-npm-global:{{ securetty_home }}/.npm-global
      - securetty-usr-local:/usr/local

      # Writable tmpfs for runtime
      - type: tmpfs
        target: /tmp
        tmpfs:
          size: 512M
      - type: tmpfs
        target: {{ securetty_home }}/.local/bin
        tmpfs:
          size: 128M

    working_dir: {{ securetty_work_dir }}
    stdin_open: true
    tty: true

    networks:
      - securetty_net

    pid: "private"
    ipc: "private"

    environment:
      - HOME={{ securetty_home }}
      - USER={{ securetty_user }}
      - XDG_RUNTIME_DIR=/run/user/{{ securetty_uid }}
      - NODE_ENV=development
      - npm_config_ignore_scripts=true
      - npm_config_cache={{ securetty_home }}/.npm
      - npm_config_prefix={{ securetty_home }}/.npm-global
      - CARGO_HOME={{ securetty_home }}/.cargo
      - GOPATH={{ securetty_home }}/go
      - GOBIN={{ securetty_home }}/go/bin
      - PYTHONUSERBASE={{ securetty_home }}/.local
      - PIP_USER=1
      - PATH={{ securetty_home }}/.npm-global/bin:{{ securetty_home }}/go/bin:{{ securetty_home }}/.cargo/bin:{{ securetty_home }}/.local/bin:/usr/local/bin:/usr/bin:/bin
      - SSH_AUTH_SOCK=/run/ssh-agent.sock
      - GPG_AGENT_INFO=/run/gpg-agent.sock
      - OMNIROUTE_BASE_URL=http://securetty-omniroute:4000
      - HEADROOM_URL=http://securetty-headroom:8787
      - OLLAMA_HOST=http://securetty-ollama:11434
      - CLOUDCLI_URL=http://securetty-cloudcli:3001

    pids_limit: 4096

    deploy:
      resources:
        limits:
          cpus: "{{ securetty_resources.dev.cpus }}"
          memory: {{ securetty_resources.dev.memory }}

    # CMD set in Containerfile (/bin/bash), ENTRYPOINT shows age banner
    # Dev container is interactive-only — exclude from `podman-compose up -d`
    # Launch via: securetty run / securetty shell
    profiles:
      - interactive
    depends_on:
      - omniroute
      - headroom
      - cloudcli
      - ollama
      - creds

  # =================================================================
  # Omniroute — unified AI provider router (160+ providers)
  # All agents route through this. Shared across containers.
  # =================================================================
  omniroute:
    build:
      context: ./omniroute
      dockerfile: Containerfile
    container_name: securetty-omniroute
    hostname: omniroute
    user: "{{ securetty_uid }}:{{ securetty_gid }}"
    userns_mode: keep-id
    cap_drop:
      - ALL
    security_opt:
      - no-new-privileges:true
      - label=disable
    read_only: true
    env_file:
      - .env.omniroute
    volumes:
      - {{ securetty_home }}/.omniroute:/data
      - type: tmpfs
        target: /tmp
        tmpfs:
          size: 128M
    networks:
      - securetty_net
    ports:
      - "127.0.0.1:4000:4000"
    deploy:
      resources:
        limits:
          cpus: "{{ securetty_resources.omniroute.cpus }}"
          memory: {{ securetty_resources.omniroute.memory }}
    restart: unless-stopped
    healthcheck:
      test: ["CMD", "curl", "-sf", "http://localhost:4000/"]
      interval: 60s
      timeout: 10s
      retries: 3
      start_period: 15s

  # =================================================================
  # Headroom — token compression MCP server
  # Agents connect via MCP config. Shared across containers.
  # =================================================================
  headroom:
    build:
      context: ./headroom
      dockerfile: Containerfile
    container_name: securetty-headroom
    hostname: headroom
    user: "{{ securetty_uid }}:{{ securetty_gid }}"
    userns_mode: keep-id
    cap_drop:
      - ALL
    security_opt:
      - no-new-privileges:true
      - label=disable
    read_only: true
    volumes:
      - headroom_data:/data
      - {{ securetty_dir }}/certs:/certs:ro
      - type: tmpfs
        target: /tmp
        tmpfs:
          size: 128M
    networks:
      - securetty_net
    deploy:
      resources:
        limits:
          cpus: "{{ securetty_resources.headroom.cpus }}"
          memory: {{ securetty_resources.headroom.memory }}
    restart: unless-stopped
    healthcheck:
      test: ["CMD", "python3.12", "-c", "import socket; s=socket.socket(); s.connect(('localhost',8787)); s.close()"]
      interval: 60s
      timeout: 10s
      retries: 3
      start_period: 30s

  # =================================================================
  # CloudCLI — Claude Code Web UI
  # Replaces systemd cloudcli.service from host
  # =================================================================
  cloudcli:
    build:
      context: ./cloudcli
      dockerfile: Containerfile
    container_name: securetty-cloudcli
    hostname: cloudcli
    user: "{{ securetty_uid }}:{{ securetty_gid }}"
    userns_mode: keep-id
    cap_drop:
      - ALL
    security_opt:
      - no-new-privileges:true
      - label=disable
    read_only: true
    volumes:
      - cloudcli_data:/data
      - {{ securetty_home }}/.claude:{{ securetty_home }}/.claude
      - {{ securetty_home }}/.claude.json:{{ securetty_home }}/.claude.json
      - {{ securetty_home }}/src:{{ securetty_home }}/src
      - {{ securetty_home }}/.gitconfig:{{ securetty_home }}/.gitconfig:ro
      - {{ securetty_home }}/.ssh/config:{{ securetty_home }}/.ssh/config:ro
      - {{ securetty_home }}/.ssh/known_hosts:{{ securetty_home }}/.ssh/known_hosts:ro
      - type: tmpfs
        target: /tmp
        tmpfs:
          size: 128M
    networks:
      - securetty_net
    ports:
      - "127.0.0.1:3001:3001"
    env_file:
      - .env.cloudcli
    environment:
      - HOST=0.0.0.0
      - SERVER_PORT=3001
      - HOME={{ securetty_home }}
      - OMNIROUTE_BASE_URL=http://securetty-omniroute:4000
      - HEADROOM_URL=http://securetty-headroom:8787
      - OLLAMA_HOST=http://securetty-ollama:11434
    deploy:
      resources:
        limits:
          cpus: "{{ securetty_resources.cloudcli.cpus }}"
          memory: {{ securetty_resources.cloudcli.memory }}
    restart: unless-stopped
    healthcheck:
      test: ["CMD", "curl", "-sf", "http://localhost:3001/"]
      interval: 60s
      timeout: 10s
      retries: 3
      start_period: 15s

  # =================================================================
  # Ollama — local LLM server
  # Replaces systemd ollama.service from host
  # GPU + NPU passthrough for inference
  # =================================================================
  ollama:
    build:
      context: ./ollama
      dockerfile: Containerfile
    container_name: securetty-ollama
    hostname: ollama
    user: "{{ securetty_uid }}:{{ securetty_gid }}"
    userns_mode: keep-id
    cap_drop:
      - ALL
    security_opt:
      - no-new-privileges:true
      - label=disable
    devices:
      - /dev/dri:/dev/dri
      - /dev/accel/accel0:/dev/accel/accel0
    volumes:
      - ollama_models:/data/models
      - type: tmpfs
        target: /tmp
        tmpfs:
          size: 256M
    networks:
      - securetty_net
    ports:
      - "127.0.0.1:11434:11434"
    environment:
      - OLLAMA_MODELS=/data/models
      - OLLAMA_HOST=0.0.0.0:11434
    deploy:
      resources:
        limits:
          cpus: "{{ securetty_resources.ollama.cpus }}"
          memory: {{ securetty_resources.ollama.memory }}
    restart: unless-stopped
    healthcheck:
      test: ["CMD", "curl", "-sf", "http://localhost:11434/"]
      interval: 60s
      timeout: 10s
      retries: 3
      start_period: 15s

  # =================================================================
  # GuardDog — behavioral malicious package scanner (YARA rules)
  # Watches shared volumes via inotify, scans on file changes
  # =================================================================
  guarddog:
    build:
      context: ./guarddog
      dockerfile: Containerfile
    container_name: securetty-guarddog
    hostname: guarddog
    user: "{{ securetty_uid }}:{{ securetty_gid }}"
    userns_mode: keep-id
    cap_drop:
      - ALL
    security_opt:
      - no-new-privileges:true
      - label=disable
    read_only: true
    volumes:
      - securetty-usr-local:/scan/usr-local:ro
      - securetty-pip-user:/scan/pip-user:ro
      - securetty-npm-global:/scan/npm-global:ro
      - securetty-npm-cache:/scan/npm-cache:ro
      - securetty-cargo-cache:/scan/cargo:ro
      - securetty-go-cache:/scan/go:ro
      - guarddog_results:/results
      - type: tmpfs
        target: /tmp
        tmpfs:
          size: 128M
    networks:
      - securetty_net
    deploy:
      resources:
        limits:
          cpus: "1"
          memory: 512M
    restart: unless-stopped
    healthcheck:
      test: ["CMD", "bash", "-c", "pgrep -f guarddog-watch || pgrep -f 'sleep'"]
      interval: 60s
      timeout: 5s
      retries: 3
      start_period: 30s

  # =================================================================
  # OSV-Scanner — known malicious/vulnerable package database checker
  # Watches shared volumes via inotify, checks against OpenSSF DB
  # =================================================================
  osv-scanner:
    build:
      context: ./osv-scanner
      dockerfile: Containerfile
    container_name: securetty-osv-scanner
    hostname: osv-scanner
    user: "{{ securetty_uid }}:{{ securetty_gid }}"
    userns_mode: keep-id
    cap_drop:
      - ALL
    security_opt:
      - no-new-privileges:true
      - label=disable
    read_only: true
    volumes:
      - securetty-usr-local:/scan/usr-local:ro
      - securetty-pip-user:/scan/pip-user:ro
      - securetty-npm-global:/scan/npm-global:ro
      - securetty-npm-cache:/scan/npm-cache:ro
      - securetty-cargo-cache:/scan/cargo:ro
      - securetty-go-cache:/scan/go:ro
      - osv_results:/results
      - type: tmpfs
        target: /tmp
        tmpfs:
          size: 128M
    networks:
      - securetty_net
    deploy:
      resources:
        limits:
          cpus: "1"
          memory: 512M
    restart: unless-stopped
    healthcheck:
      test: ["CMD", "bash", "-c", "pgrep -f osv-watch || pgrep -f 'sleep'"]
      interval: 60s
      timeout: 5s
      retries: 3
      start_period: 30s

  # =================================================================
  # Credential Proxy — git/glab/gh token provider (zero-secret agents)
  # =================================================================
  creds:
    build:
      context: ./creds
      dockerfile: Containerfile
    container_name: securetty-creds
    hostname: creds
    user: "{{ securetty_uid }}:{{ securetty_gid }}"
    userns_mode: keep-id
    cap_drop:
      - ALL
    security_opt:
      - no-new-privileges:true
      - label=disable
    read_only: true
    env_file:
      - .env.creds
    volumes:
      - {{ securetty_dir }}/certs:/certs:ro
      - {{ securetty_dir }}/credentials.json:/config/credentials.json:ro
      - type: tmpfs
        target: /tmp
        tmpfs:
          size: 64M
    networks:
      - securetty_net
    deploy:
      resources:
        limits:
          cpus: "0.5"
          memory: 128M
    restart: unless-stopped
    healthcheck:
      test: ["CMD", "python3.12", "-c", "import ssl,http.client;ctx=ssl.SSLContext(ssl.PROTOCOL_TLS_CLIENT);ctx.check_hostname=False;ctx.load_cert_chain('/certs/client.crt','/certs/client.key');ctx.load_verify_locations('/certs/ca.crt');c=http.client.HTTPSConnection('localhost',8800,context=ctx);c.request('GET','/health');exit(0 if c.getresponse().status==200 else 1)"]
      interval: 60s
      timeout: 5s
      retries: 3
      start_period: 10s

  # MCP Gateway — 5 MCP servers (jira, gitlab, github, slack, wordpress) in one container
  mcp-gateway:
    build:
      context: ./mcp
      dockerfile: Containerfile
    container_name: securetty-mcp-gateway
    hostname: mcp-gateway
    user: "{{ securetty_uid }}:{{ securetty_gid }}"
    userns_mode: keep-id
    cap_drop: [ALL]
    security_opt: [no-new-privileges:true, label=disable]
    read_only: true
    env_file:
      - .env.mcp-jira
      - .env.mcp-gitlab
      - .env.mcp-github
      - .env.mcp-slack
      - .env.mcp-wordpress
    volumes:
      - {{ securetty_mcp_skills_dir }}/jira:/mcp/jira:ro
      - {{ securetty_mcp_skills_dir }}/gitlab:/mcp/gitlab:ro
      - {{ securetty_mcp_skills_dir }}/github:/mcp/github:ro
      - {{ securetty_mcp_skills_dir }}/slack:/mcp/slack:ro
      - {{ securetty_mcp_skills_dir }}/wordpress:/mcp/wordpress:ro
      - {{ securetty_dir }}/certs:/certs:ro
      - {{ securetty_dir }}/roles/containers/files/mcp-gateway-supervisor.py:/usr/local/bin/mcp-gateway-supervisor:ro
      - type: tmpfs
        target: /tmp
        tmpfs:
          size: 256M
    networks: [securetty_net]
    deploy:
      resources:
        limits:
          cpus: "2.0"
          memory: 768M
    restart: unless-stopped
    command: ["python3.12", "/usr/local/bin/mcp-gateway-supervisor"]
    healthcheck:
      test: ["CMD", "python3.12", "-c", "import socket;\nfor p in [8801,8802,8803,8804,8805]:\n s=socket.socket(); s.connect(('localhost',p)); s.close()"]
      interval: 60s
      timeout: 10s
      retries: 3
      start_period: 20s

  # Jira poller — discovers untriaged issues, feeds to triage agent
  jira-poller:
    image: localhost/securetty_devbase:latest
    container_name: securetty-jira-poller
    hostname: jira-poller
    user: "{{ securetty_uid }}:{{ securetty_gid }}"
    userns_mode: keep-id
    cap_drop: [ALL]
    security_opt: [no-new-privileges:true, label=disable]
    read_only: true
    env_file:
      - .env.mcp-jira
    environment:
      - HOME={{ securetty_home }}
      - SECURETTY_JIRA_URL=${JIRA_URL}
      - SECURETTY_JIRA_USER=${JIRA_EMAIL}
      - JIRA_API_TOKEN=${JIRA_JPAT}
      - SECURETTY_JIRA_PROJECTS={{ securetty_jira_triage.projects }}
      - SECURETTY_JIRA_POLL_INTERVAL={{ securetty_jira_triage.poll_interval }}
      - SECURETTY_DISPATCHER_URL=https://dispatcher:8900
      - SECURETTY_WORK_DIR={{ securetty_work_dir }}
      - 'SECURETTY_PROJECT_REGISTRY={{ securetty_project_registry | to_json }}'
    volumes:
      - {{ securetty_dir }}/roles/containers/files/securetty-jira-poller.sh:/app/securetty-jira-poller.sh:ro
      - {{ securetty_dir }}/roles/containers/files/securetty-jira-triage.sh:/app/securetty-jira-triage.sh:ro
      - {{ securetty_dir }}/certs:/certs:ro
      - {{ securetty_work_dir }}:{{ securetty_work_dir }}
      - type: tmpfs
        target: /tmp
        tmpfs:
          size: 32M
      - type: tmpfs
        target: /tmp/securetty-state
        tmpfs:
          size: 16M
    working_dir: /app
    networks: [securetty_net]
    depends_on:
      - dispatcher
    deploy:
      resources:
        limits:
          cpus: "0.25"
          memory: 128M
    pids_limit: 64
    restart: unless-stopped
    command: ["bash", "/app/securetty-jira-poller.sh", "start", "--foreground"]
    healthcheck:
      test: ["CMD", "bash", "-c", "[ -f /tmp/securetty-state/jira-poller.pid ] && kill -0 $(cat /tmp/securetty-state/jira-poller.pid 2>/dev/null) 2>/dev/null"]
      interval: 60s
      timeout: 5s
      retries: 3
      start_period: 30s

  # =================================================================
  # Review manager — tracks MR/PR lifecycle for triaged issues
  # =================================================================
  review-manager:
    image: localhost/securetty_devbase:latest
    container_name: securetty-review-manager
    hostname: review-manager
    user: "{{ securetty_uid }}:{{ securetty_gid }}"
    userns_mode: keep-id
    cap_drop: [ALL]
    security_opt: [no-new-privileges:true, label=disable]
    read_only: true
    env_file:
      - .env.mcp-jira
      - .env.mcp-github
      - .env.mcp-gitlab
    environment:
      - HOME={{ securetty_home }}
      - SECURETTY_JIRA_URL=${JIRA_URL}
      - SECURETTY_JIRA_USER=${JIRA_EMAIL}
      - JIRA_API_TOKEN=${JIRA_JPAT}
      - GH_TOKEN=${GITHUB_TOKEN}
      - GITLAB_TOKEN=${GITLAB_TOKEN}
      - SECURETTY_DISPATCHER_URL=https://dispatcher:8900
      - SECURETTY_REVIEW_POLL_INTERVAL={{ securetty_jira_triage.review_poll_interval }}
      - SECURETTY_REVIEW_STALE_HOURS={{ securetty_jira_triage.stale_review_hours }}
      - SECURETTY_AUTO_MERGE={{ securetty_jira_triage.auto_merge | string | lower }}
      - SECURETTY_WORK_DIR={{ securetty_work_dir }}
    volumes:
      - {{ securetty_dir }}/roles/containers/files/securetty-review-manager.sh:/app/securetty-review-manager.sh:ro
      - {{ securetty_dir }}/certs:/certs:ro
      - {{ securetty_home }}/.gitconfig:{{ securetty_home }}/.gitconfig:ro
      - type: tmpfs
        target: /tmp
        tmpfs:
          size: 32M
      - type: tmpfs
        target: /tmp/securetty-state
        tmpfs:
          size: 16M
    working_dir: /app
    networks: [securetty_net]
    depends_on:
      - dispatcher
    deploy:
      resources:
        limits:
          cpus: "0.25"
          memory: 128M
    pids_limit: 64
    restart: unless-stopped
    command: ["bash", "/app/securetty-review-manager.sh", "start", "--foreground"]
    healthcheck:
      test: ["CMD", "bash", "-c", "[ -f /tmp/securetty-state/review-manager.pid ]"]
      interval: 60s
      timeout: 5s
      retries: 3
      start_period: 30s

  # =================================================================
  # Podman proxy — restricted API access for dispatcher job launching
  # =================================================================
  podman-proxy:
    image: localhost/securetty_dispatcher:latest
    container_name: securetty-podman-proxy
    hostname: podman-proxy
    user: "{{ securetty_uid }}:{{ securetty_gid }}"
    userns_mode: keep-id
    cap_drop: [ALL]
    security_opt: [no-new-privileges:true, label=disable]
    read_only: true
    volumes:
      - {{ securetty_dir }}/certs:/certs:ro
      - {{ securetty_dir }}/dispatcher/podman-proxy.py:/app/podman-proxy.py:ro
      - /run/user/{{ securetty_uid }}/podman/podman.sock:/run/podman/podman.sock:ro
      - type: tmpfs
        target: /tmp
        tmpfs:
          size: 32M
    networks: [securetty_net]
    deploy:
      resources:
        limits:
          cpus: "0.25"
          memory: 64M
    pids_limit: 64
    restart: unless-stopped
    command: ["python3.12", "/app/podman-proxy.py"]
    healthcheck:
      test: ["CMD", "python3.12", "-c", "import socket; s=socket.socket(); s.connect(('localhost',9402)); s.close()"]
      interval: 60s
      timeout: 5s
      retries: 3
      start_period: 10s

  # =================================================================
  # Dispatcher — workflow routing, job queue, event triggers
  # =================================================================
  dispatcher:
    build:
      context: .
      dockerfile: dispatcher/Containerfile
    container_name: securetty-dispatcher
    hostname: dispatcher
    user: "{{ securetty_uid }}:{{ securetty_gid }}"
    userns_mode: keep-id
    cap_drop: [ALL]
    security_opt: [no-new-privileges:true, label=disable]
    read_only: true
    environment:
      - PODMAN_SOCKET=tcp://podman-proxy:9402
    volumes:
      - {{ securetty_dir }}/certs:/certs:ro
      - {{ securetty_dir }}/roles/containers/files/workflows.toon:/config/workflows.toon:ro
      - {{ securetty_dir }}/workflows:/workflows:ro
      - dispatcher_data:/data
      - type: tmpfs
        target: /tmp
        tmpfs:
          size: 64M
    networks: [securetty_net]
    depends_on:
      - podman-proxy
    deploy:
      resources:
        limits:
          cpus: "1.0"
          memory: 256M
    pids_limit: 256
    restart: unless-stopped
    command: ["python3.12", "-c", "from app import app; import uvicorn; uvicorn.run(app, host='0.0.0.0', port=8900, ssl_certfile='/certs/dispatcher.crt', ssl_keyfile='/certs/dispatcher.key', ssl_ca_certs='/certs/ca.crt')"]
    healthcheck:
      test: ["CMD", "python3.12", "-c", "import socket; s=socket.socket(); s.connect(('localhost',8900)); s.close()"]
      interval: 60s
      timeout: 5s
      retries: 3
      start_period: 15s

