version: "3.8"

services:
  dev:
    build:
      context: .
      dockerfile: Containerfile
    container_name: securetty
    hostname: securetty

    # Non-root, minimal capabilities for Wayland/devkit
    user: "{{ securetty_uid }}:{{ securetty_gid }}"
    userns_mode: keep-id
    cap_drop:
      - ALL
    security_opt:
      - no-new-privileges:true
      - label=disable
      - "mask=/proc/mounts:/proc/self/mounts:/proc/self/mountinfo:/proc/cmdline:/proc/partitions:/proc/diskstats:/proc/version:/sys/class/dmi"

    # Read-only root filesystem — explicit writable mounts below
    read_only: true

    volumes:
      # =================================================================
      # Source repos — same path as host, rw
      # =================================================================
      - {{ securetty_home }}/src:{{ securetty_home }}/src

      # Host tool symlinks (~/bin → ~/src/*/scripts)
      - {{ securetty_home }}/bin:{{ securetty_home }}/bin:ro

      # Kubernetes/OpenShift config
      - {{ securetty_home }}/.kube:{{ securetty_home }}/.kube

      # AWS config
      - {{ securetty_home }}/.aws:{{ securetty_home }}/.aws:ro

      # Claude config
      - {{ securetty_home }}/.claude.json:{{ securetty_home }}/.claude.json

      # Downloads
      - {{ securetty_home }}/Downloads:{{ securetty_home }}/Downloads

      # Audio (PipeWire/PulseAudio for notification sounds)
      - /run/user/{{ securetty_uid }}/pipewire-0:/run/user/{{ securetty_uid }}/pipewire-0
      - /run/user/{{ securetty_uid }}/pulse:/run/user/{{ securetty_uid }}/pulse

      # Pipenv virtualenvs
      - {{ securetty_home }}/.local/share/virtualenvs:{{ securetty_home }}/.local/share/virtualenvs

      # AI agent config dirs — full mount for persistence
{% for dir in securetty_agent_config_dirs %}
      - {{ securetty_home }}/{{ dir }}:{{ securetty_home }}/{{ dir }}
{% endfor %}

      # --- xdg-open relay socket (URLs sent to host browser) ---
      - /run/user/{{ securetty_uid }}/securetty-open.sock:/run/securetty-open.sock

      # --- SSH: restricted agent ({{ securetty_ssh_key }}, no private key in container) ---
      - /run/user/{{ securetty_uid }}/securetty-ssh-agent.sock:/run/ssh-agent.sock:ro
      - {{ securetty_home }}/.ssh/config:{{ securetty_home }}/.ssh/config:ro
      - {{ securetty_home }}/.ssh/known_hosts:{{ securetty_home }}/.ssh/known_hosts:ro

      # --- GPG agent forwarding (extra-socket, no key export) ---
      - ${GPG_AGENT_EXTRA_SOCK:-/dev/null}:/run/gpg-agent.sock:ro
      - {{ securetty_home }}/.gnupg/pubring.kbx:{{ securetty_home }}/.gnupg/pubring.kbx:ro
      - {{ securetty_home }}/.gnupg/trustdb.gpg:{{ securetty_home }}/.gnupg/trustdb.gpg:ro
      - {{ securetty_home }}/.gitconfig:{{ securetty_home }}/.gitconfig:ro

      # Shared package caches (persist across containers)
      - securetty-npm-cache:{{ securetty_home }}/.npm
      - securetty-pip-cache:{{ securetty_home }}/.cache/pip
      - securetty-uv-cache:{{ securetty_home }}/.cache/uv
      - securetty-cargo-cache:{{ securetty_home }}/.cargo
      - securetty-go-cache:{{ securetty_home }}/go
      - securetty-pip-user:{{ securetty_home }}/.local/lib
      - securetty-npm-global:{{ securetty_home }}/.npm-global
      - securetty-usr-local:/usr/local

      # Writable tmpfs for runtime
      - type: tmpfs
        target: /tmp
        tmpfs:
          size: 512M
      - type: tmpfs
        target: {{ securetty_home }}/.local/bin
        tmpfs:
          size: 128M

    working_dir: {{ securetty_home }}/src
    stdin_open: true
    tty: true

    networks:
      - securetty_net

    pid: "private"
    ipc: "private"

    environment:
      - HOME={{ securetty_home }}
      - USER={{ securetty_user }}
      - XDG_RUNTIME_DIR=/run/user/{{ securetty_uid }}
      - NODE_ENV=development
      - npm_config_ignore_scripts=true
      - npm_config_cache={{ securetty_home }}/.npm
      - npm_config_prefix={{ securetty_home }}/.npm-global
      - CARGO_HOME={{ securetty_home }}/.cargo
      - GOPATH={{ securetty_home }}/go
      - GOBIN={{ securetty_home }}/go/bin
      - PYTHONUSERBASE={{ securetty_home }}/.local
      - PIP_USER=1
      - PATH={{ securetty_home }}/.npm-global/bin:{{ securetty_home }}/go/bin:{{ securetty_home }}/.cargo/bin:{{ securetty_home }}/.local/bin:/usr/local/bin:/usr/bin:/bin
      - SSH_AUTH_SOCK=/run/ssh-agent.sock
      - GPG_AGENT_INFO=/run/gpg-agent.sock
      - OMNIROUTE_BASE_URL=http://securetty-omniroute:4000
      - HEADROOM_URL=http://securetty-headroom:8787
      - OLLAMA_HOST=http://securetty-ollama:11434
      - CLOUDCLI_URL=http://securetty-cloudcli:3001

    pids_limit: 4096

    deploy:
      resources:
        limits:
          cpus: "{{ securetty_resources.dev.cpus }}"
          memory: {{ securetty_resources.dev.memory }}

    # CMD set in Containerfile (/bin/bash), ENTRYPOINT shows age banner
    depends_on:
      - omniroute
      - headroom
      - cloudcli
      - ollama
      - creds

  # =================================================================
  # Omniroute — unified AI provider router (160+ providers)
  # All agents route through this. Shared across containers.
  # =================================================================
  omniroute:
    build:
      context: ./omniroute
      dockerfile: Containerfile
    container_name: securetty-omniroute
    hostname: omniroute
    user: "{{ securetty_uid }}:{{ securetty_gid }}"
    userns_mode: keep-id
    cap_drop:
      - ALL
    security_opt:
      - no-new-privileges:true
      - label=disable
    read_only: true
    env_file:
      - .env.omniroute
    volumes:
      - {{ securetty_home }}/.omniroute:/data
      - type: tmpfs
        target: /tmp
        tmpfs:
          size: 128M
    networks:
      - securetty_net
    ports:
      - "127.0.0.1:4000:4000"
    deploy:
      resources:
        limits:
          cpus: "{{ securetty_resources.omniroute.cpus }}"
          memory: {{ securetty_resources.omniroute.memory }}
    restart: unless-stopped
    healthcheck:
      test: ["CMD", "curl", "-sf", "http://localhost:4000/"]
      interval: 60s
      timeout: 10s
      retries: 3
      start_period: 15s

  # =================================================================
  # Headroom — token compression MCP server
  # Agents connect via MCP config. Shared across containers.
  # =================================================================
  headroom:
    build:
      context: ./headroom
      dockerfile: Containerfile
    container_name: securetty-headroom
    hostname: headroom
    user: "{{ securetty_uid }}:{{ securetty_gid }}"
    userns_mode: keep-id
    cap_drop:
      - ALL
    security_opt:
      - no-new-privileges:true
      - label=disable
    read_only: true
    volumes:
      - headroom_data:/data
      - {{ securetty_dir }}/certs:/certs:ro
      - type: tmpfs
        target: /tmp
        tmpfs:
          size: 128M
    networks:
      - securetty_net
    deploy:
      resources:
        limits:
          cpus: "{{ securetty_resources.headroom.cpus }}"
          memory: {{ securetty_resources.headroom.memory }}
    restart: unless-stopped
    healthcheck:
      test: ["CMD", "python3.12", "-c", "import socket; s=socket.socket(); s.connect(('localhost',8787)); s.close()"]
      interval: 60s
      timeout: 10s
      retries: 3
      start_period: 30s

  # =================================================================
  # CloudCLI — Claude Code Web UI
  # Replaces systemd cloudcli.service from host
  # =================================================================
  cloudcli:
    build:
      context: ./cloudcli
      dockerfile: Containerfile
    container_name: securetty-cloudcli
    hostname: cloudcli
    user: "{{ securetty_uid }}:{{ securetty_gid }}"
    userns_mode: keep-id
    cap_drop:
      - ALL
    security_opt:
      - no-new-privileges:true
      - label=disable
    read_only: true
    volumes:
      - cloudcli_data:/data
      - type: tmpfs
        target: /tmp
        tmpfs:
          size: 128M
    networks:
      - securetty_net
    ports:
      - "127.0.0.1:3001:3001"
    env_file:
      - .env.cloudcli
    environment:
      - HOST=0.0.0.0
      - SERVER_PORT=3001
      - HOME=/data
    deploy:
      resources:
        limits:
          cpus: "{{ securetty_resources.cloudcli.cpus }}"
          memory: {{ securetty_resources.cloudcli.memory }}
    restart: unless-stopped
    healthcheck:
      test: ["CMD", "curl", "-sf", "http://localhost:3001/"]
      interval: 60s
      timeout: 10s
      retries: 3
      start_period: 15s

  # =================================================================
  # Ollama — local LLM server
  # Replaces systemd ollama.service from host
  # GPU + NPU passthrough for inference
  # =================================================================
  ollama:
    build:
      context: ./ollama
      dockerfile: Containerfile
    container_name: securetty-ollama
    hostname: ollama
    user: "{{ securetty_uid }}:{{ securetty_gid }}"
    userns_mode: keep-id
    cap_drop:
      - ALL
    security_opt:
      - no-new-privileges:true
      - label=disable
    devices:
      - /dev/dri:/dev/dri
      - /dev/accel/accel0:/dev/accel/accel0
    volumes:
      - ollama_models:/data/models
      - type: tmpfs
        target: /tmp
        tmpfs:
          size: 256M
    networks:
      - securetty_net
    ports:
      - "127.0.0.1:11434:11434"
    environment:
      - OLLAMA_MODELS=/data/models
      - OLLAMA_HOST=0.0.0.0:11434
    deploy:
      resources:
        limits:
          cpus: "{{ securetty_resources.ollama.cpus }}"
          memory: {{ securetty_resources.ollama.memory }}
    restart: unless-stopped
    healthcheck:
      test: ["CMD", "curl", "-sf", "http://localhost:11434/"]
      interval: 60s
      timeout: 10s
      retries: 3
      start_period: 15s

  # =================================================================
  # GuardDog — behavioral malicious package scanner (YARA rules)
  # Watches shared volumes via inotify, scans on file changes
  # =================================================================
  guarddog:
    build:
      context: ./guarddog
      dockerfile: Containerfile
    container_name: securetty-guarddog
    hostname: guarddog
    user: "{{ securetty_uid }}:{{ securetty_gid }}"
    userns_mode: keep-id
    cap_drop:
      - ALL
    security_opt:
      - no-new-privileges:true
      - label=disable
    read_only: true
    volumes:
      - securetty-usr-local:/scan/usr-local:ro
      - securetty-pip-user:/scan/pip-user:ro
      - securetty-npm-global:/scan/npm-global:ro
      - securetty-npm-cache:/scan/npm-cache:ro
      - securetty-cargo-cache:/scan/cargo:ro
      - securetty-go-cache:/scan/go:ro
      - guarddog_results:/results
      - type: tmpfs
        target: /tmp
        tmpfs:
          size: 128M
    networks:
      - securetty_net
    deploy:
      resources:
        limits:
          cpus: "1"
          memory: 512M
    restart: unless-stopped
    healthcheck:
      test: ["CMD", "bash", "-c", "pgrep -f guarddog-watch || pgrep -f 'sleep'"]
      interval: 60s
      timeout: 5s
      retries: 3
      start_period: 30s

  # =================================================================
  # OSV-Scanner — known malicious/vulnerable package database checker
  # Watches shared volumes via inotify, checks against OpenSSF DB
  # =================================================================
  osv-scanner:
    build:
      context: ./osv-scanner
      dockerfile: Containerfile
    container_name: securetty-osv-scanner
    hostname: osv-scanner
    user: "{{ securetty_uid }}:{{ securetty_gid }}"
    userns_mode: keep-id
    cap_drop:
      - ALL
    security_opt:
      - no-new-privileges:true
      - label=disable
    read_only: true
    volumes:
      - securetty-usr-local:/scan/usr-local:ro
      - securetty-pip-user:/scan/pip-user:ro
      - securetty-npm-global:/scan/npm-global:ro
      - securetty-npm-cache:/scan/npm-cache:ro
      - securetty-cargo-cache:/scan/cargo:ro
      - securetty-go-cache:/scan/go:ro
      - osv_results:/results
      - type: tmpfs
        target: /tmp
        tmpfs:
          size: 128M
    networks:
      - securetty_net
    deploy:
      resources:
        limits:
          cpus: "1"
          memory: 512M
    restart: unless-stopped
    healthcheck:
      test: ["CMD", "bash", "-c", "pgrep -f osv-watch || pgrep -f 'sleep'"]
      interval: 60s
      timeout: 5s
      retries: 3
      start_period: 30s

  # =================================================================
  # Credential Proxy — git/glab/gh token provider (zero-secret agents)
  # =================================================================
  creds:
    build:
      context: ./creds
      dockerfile: Containerfile
    container_name: securetty-creds
    hostname: creds
    user: "{{ securetty_uid }}:{{ securetty_gid }}"
    userns_mode: keep-id
    cap_drop:
      - ALL
    security_opt:
      - no-new-privileges:true
      - label=disable
    read_only: true
    env_file:
      - .env.creds
    volumes:
      - {{ securetty_dir }}/certs:/certs:ro
      - {{ securetty_dir }}/credentials.json:/config/credentials.json:ro
      - type: tmpfs
        target: /tmp
        tmpfs:
          size: 64M
    networks:
      - securetty_net
    deploy:
      resources:
        limits:
          cpus: "0.5"
          memory: 128M
    restart: unless-stopped
    healthcheck:
      test: ["CMD", "python3.12", "-c", "import socket; s=socket.socket(); s.connect(('localhost',8800)); s.close()"]
      interval: 60s
      timeout: 5s
      retries: 3
      start_period: 5s

  # =================================================================
  # ThickMCP services — hold secrets, serve MCP over HTTP
  # =================================================================
  mcp-jira:
    build:
      context: ./mcp
      dockerfile: Containerfile
    container_name: securetty-mcp-jira
    hostname: mcp-jira
    user: "{{ securetty_uid }}:{{ securetty_gid }}"
    userns_mode: keep-id
    cap_drop: [ALL]
    security_opt: [no-new-privileges:true, label=disable]
    read_only: true
    env_file: .env.mcp-jira
    volumes:
      - {{ securetty_home }}/src/agent-mcp-skills/jira:/mcp:ro
      - {{ securetty_dir }}/certs:/certs:ro
      - type: tmpfs
        target: /tmp
        tmpfs:
          size: 64M
    networks: [securetty_net]
    deploy:
      resources:
        limits:
          cpus: "0.5"
          memory: 256M
    restart: unless-stopped
    command: ["python3.12", "-c", "import sys; sys.path.insert(0,'/mcp'); from server import mcp; app=mcp.http_app(); import uvicorn; uvicorn.run(app, host='0.0.0.0', port=8801, ssl_certfile='/certs/server.crt', ssl_keyfile='/certs/server.key')"]
    healthcheck:
      test: ["CMD", "python3.12", "-c", "import socket; s=socket.socket(); s.connect(('localhost',8801)); s.close()"]
      interval: 60s
      timeout: 5s
      retries: 3
      start_period: 15s

  mcp-gitlab:
    build:
      context: ./mcp
      dockerfile: Containerfile
    container_name: securetty-mcp-gitlab
    hostname: mcp-gitlab
    user: "{{ securetty_uid }}:{{ securetty_gid }}"
    userns_mode: keep-id
    cap_drop: [ALL]
    security_opt: [no-new-privileges:true, label=disable]
    read_only: true
    env_file: .env.mcp-gitlab
    volumes:
      - {{ securetty_home }}/src/agent-mcp-skills/gitlab:/mcp:ro
      - {{ securetty_dir }}/certs:/certs:ro
      - type: tmpfs
        target: /tmp
        tmpfs:
          size: 64M
    networks: [securetty_net]
    deploy:
      resources:
        limits:
          cpus: "0.5"
          memory: 256M
    restart: unless-stopped
    command: ["python3.12", "-c", "import sys; sys.path.insert(0,'/mcp'); from server import mcp; app=mcp.http_app(); import uvicorn; uvicorn.run(app, host='0.0.0.0', port=8802, ssl_certfile='/certs/server.crt', ssl_keyfile='/certs/server.key')"]
    healthcheck:
      test: ["CMD", "python3.12", "-c", "import socket; s=socket.socket(); s.connect(('localhost',8802)); s.close()"]
      interval: 60s
      timeout: 5s
      retries: 3
      start_period: 15s

  mcp-github:
    build:
      context: ./mcp
      dockerfile: Containerfile
    container_name: securetty-mcp-github
    hostname: mcp-github
    user: "{{ securetty_uid }}:{{ securetty_gid }}"
    userns_mode: keep-id
    cap_drop: [ALL]
    security_opt: [no-new-privileges:true, label=disable]
    read_only: true
    env_file: .env.mcp-github
    volumes:
      - {{ securetty_home }}/src/agent-mcp-skills/github:/mcp:ro
      - {{ securetty_dir }}/certs:/certs:ro
      - type: tmpfs
        target: /tmp
        tmpfs:
          size: 64M
    networks: [securetty_net]
    deploy:
      resources:
        limits:
          cpus: "0.5"
          memory: 256M
    restart: unless-stopped
    command: ["python3.12", "-c", "import sys; sys.path.insert(0,'/mcp'); from server import mcp; app=mcp.http_app(); import uvicorn; uvicorn.run(app, host='0.0.0.0', port=8803, ssl_certfile='/certs/server.crt', ssl_keyfile='/certs/server.key')"]
    healthcheck:
      test: ["CMD", "python3.12", "-c", "import socket; s=socket.socket(); s.connect(('localhost',8803)); s.close()"]
      interval: 60s
      timeout: 5s
      retries: 3
      start_period: 15s

  mcp-slack:
    build:
      context: ./mcp
      dockerfile: Containerfile
    container_name: securetty-mcp-slack
    hostname: mcp-slack
    user: "{{ securetty_uid }}:{{ securetty_gid }}"
    userns_mode: keep-id
    cap_drop: [ALL]
    security_opt: [no-new-privileges:true, label=disable]
    read_only: true
    env_file: .env.mcp-slack
    volumes:
      - {{ securetty_home }}/src/agent-mcp-skills/slack:/mcp:ro
      - {{ securetty_dir }}/certs:/certs:ro
      - type: tmpfs
        target: /tmp
        tmpfs:
          size: 64M
    networks: [securetty_net]
    deploy:
      resources:
        limits:
          cpus: "0.5"
          memory: 256M
    restart: unless-stopped
    command: ["python3.12", "-c", "import sys; sys.path.insert(0,'/mcp'); from server import mcp; app=mcp.http_app(); import uvicorn; uvicorn.run(app, host='0.0.0.0', port=8804, ssl_certfile='/certs/server.crt', ssl_keyfile='/certs/server.key')"]
    healthcheck:
      test: ["CMD", "python3.12", "-c", "import socket; s=socket.socket(); s.connect(('localhost',8804)); s.close()"]
      interval: 60s
      timeout: 5s
      retries: 3
      start_period: 15s

  mcp-wordpress:
    build:
      context: ./mcp
      dockerfile: Containerfile
    container_name: securetty-mcp-wordpress
    hostname: mcp-wordpress
    user: "{{ securetty_uid }}:{{ securetty_gid }}"
    userns_mode: keep-id
    cap_drop: [ALL]
    security_opt: [no-new-privileges:true, label=disable]
    read_only: true
    env_file: .env.mcp-wordpress
    volumes:
      - {{ securetty_home }}/src/agent-mcp-skills/wordpress:/mcp:ro
      - {{ securetty_dir }}/certs:/certs:ro
      - type: tmpfs
        target: /tmp
        tmpfs:
          size: 64M
    networks: [securetty_net]
    deploy:
      resources:
        limits:
          cpus: "0.5"
          memory: 256M
    restart: unless-stopped
    command: ["python3.12", "-c", "import sys; sys.path.insert(0,'/mcp'); from server import mcp; app=mcp.http_app(); import uvicorn; uvicorn.run(app, host='0.0.0.0', port=8805, ssl_certfile='/certs/server.crt', ssl_keyfile='/certs/server.key')"]
    healthcheck:
      test: ["CMD", "python3.12", "-c", "import socket; s=socket.socket(); s.connect(('localhost',8805)); s.close()"]
      interval: 60s
      timeout: 5s
      retries: 3
      start_period: 15s

volumes:
  securetty-npm-cache:
    name: securetty-npm-cache
  securetty-pip-cache:
    name: securetty-pip-cache
  securetty-uv-cache:
    name: securetty-uv-cache
  securetty-cargo-cache:
    name: securetty-cargo-cache
  securetty-go-cache:
    name: securetty-go-cache
  securetty-pip-user:
    name: securetty-pip-user
  securetty-npm-global:
    name: securetty-npm-global
  securetty-usr-local:
    name: securetty-usr-local
  guarddog_results:
    name: securetty-guarddog-results
  osv_results:
    name: securetty-osv-results
  headroom_data:
    name: securetty-headroom-data
  cloudcli_data:
    name: securetty-cloudcli-data
  ollama_models:
    name: securetty-ollama-models

networks:
  securetty_net:
    external: true
    name: {{ securetty_network_name }}
