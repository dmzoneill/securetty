#!/bin/bash
# Container-side xdg-open shim.
# Sends URL to host relay socket. Only http/https URLs forwarded.
# Non-URL arguments printed to terminal (fallback behavior).

SOCKET_PATH="/run/securetty-open.sock"
url="${1:-}"

if [ -z "$url" ]; then
    echo "Usage: xdg-open <url>" >&2
    exit 1
fi

# Only forward http/https URLs to host
if echo "$url" | grep -qE '^https?://'; then
    if [ -S "$SOCKET_PATH" ]; then
        echo "$url" | socat - UNIX-CONNECT:"$SOCKET_PATH" 2>/dev/null
        echo "Sent to host browser: $url"
    else
        # Socket not available — print URL for manual copy
        echo ""
        echo "Open this URL on your host machine:"
        echo "  $url"
        echo ""
    fi
else
    # Not a URL — just print it (some tools pass file paths)
    echo "Cannot open in container: $url"
    echo "Copy this to your host if needed."
fi
