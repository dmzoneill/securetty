#!/bin/bash
# git-credential-securetty — fetches credentials from securetty-creds proxy
[ "$1" = "get" ] || exit 0

declare -A c
while IFS='=' read -r k v; do
    [ -z "$k" ] && break
    c[$k]="$v"
done

host="${c[host]:-}"
protocol="${c[protocol]:-https}"

[ -z "$host" ] && exit 1

CERT_ARGS=""
[ -f /certs/client.crt ] && CERT_ARGS="--cert /certs/client.crt --key /certs/client.key --cacert /certs/ca.crt"

curl $CERT_ARGS -sf "https://securetty-creds:8800/credential?host=${host}&protocol=${protocol}" 2>/dev/null \
  || curl -sf "http://securetty-creds:8800/credential?host=${host}&protocol=${protocol}" 2>/dev/null \
  || exit 1
